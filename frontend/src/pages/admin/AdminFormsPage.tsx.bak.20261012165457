import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
  FormDetail,
  FormStatus,
  FormType,
  createForm,
  deleteForm,
  duplicateForm,
  getAdminForms,
  setFormStatus,
  FormType,
} from "../../api/forms";
import { Button, Card, Input, Label, LoadError, Spinner, Textarea } from "../../components/ui";

const STATUS_LABEL: Record<FormStatus, { label: string; color: string }> = {
  DRAFT: { label: "پیش‌نویس", color: "var(--surface)" },
  ACTIVE: { label: "فعال", color: "var(--accent)" },
  ARCHIVED: { label: "بایگانی‌شده", color: "#888" },
};

export function AdminFormsPage() {
  const [forms, setForms] = useState<FormDetail[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Form creation modal state
  const [showCreate, setShowCreate] = useState(false);
  const [title, setTitle] = useState("");
  const [slug, setSlug] = useState("");
  const [description, setDescription] = useState("");
  const [type, setType] = useState<FormType>("EVALUATION");
  const [submitting, setSubmitting] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);

  const loadForms = async () => {
    setLoading(true);
    setError(null);
    try {
      const data = await getAdminForms();
      setForms(data);
    } catch {
      setError("خطا در بارگذاری فهرست فرم‌ها");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadForms();
  }, []);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title.trim()) {
      setFormError("عنوان فرم الزامی است.");
      return;
    }
    setSubmitting(true);
    setFormError(null);
    try {
      await createForm({
        title: title.trim(),
        slug: slug.trim() || undefined,
        description: description.trim() || undefined,
      });
      setTitle("");
      setSlug("");
      setDescription("");
      setShowCreate(false);
      loadForms();
    } catch (err: any) {
      setFormError(err.response?.data?.error || "خطا در ایجاد فرم جدید");
    } finally {
      setSubmitting(false);
    }
  };

  const handleToggleStatus = async (form: FormDetail) => {
    const nextStatus: FormStatus = form.status === "ACTIVE" ? "DRAFT" : "ACTIVE";
    try {
      await setFormStatus(form.id, nextStatus);
      loadForms();
    } catch {
      alert("خطا در تغییر وضعیت فرم");
    }
  };

  const handleDuplicate = async (id: string) => {
    try {
      await duplicateForm(id);
      loadForms();
    } catch {
      alert("خطا در کپی فرم");
    }
  };

  const handleDelete = async (id: string, title: string) => {
    if (!window.confirm(`آیا از حذف کامل فرم «${title}» و تمام پاسخ‌های آن اطمینان دارید؟`)) return;
    try {
      await deleteForm(id);
      loadForms();
    } catch {
      alert("خطا در حذف فرم");
    }
  };

  if (loading) {
    return (
      <div className="flex justify-center py-20">
        <Spinner />
      </div>
    );
  }

  if (error) {
    return <LoadError message={error} onRetry={loadForms} />;
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 className="text-xl font-bold">مدیریت فرم‌ها و پرسشنامه‌ها</h1>
          <p className="mt-1 text-xs opacity-70">
            ساخت فرم‌های اختصاصی، نظرسنجی و پرسشنامه‌ها به همراه تحلیل پاسخ‌ها
          </p>
        </div>
        <Button onClick={() => setShowCreate(true)}>+ ساخت فرم جدید</Button>
      </div>

      {showCreate && (
        <Card className="animate-fadeIn">
          <form onSubmit={handleCreate} className="space-y-4">
            <h2 className="text-base font-semibold">ایجاد فرم جدید</h2>
            {formError && <p className="text-xs text-red-400">{formError}</p>}
            <div className="grid gap-4 md:grid-cols-3">
              <div>
                <Label>نوع فرم *</Label>
                <select
                  id="form-type-select"
                  value={type}
                  onChange={(e) => setType(e.target.value as FormType)}
                  className="w-full rounded-md border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm text-[var(--text)] focus:outline-none"
                >
                  <option value="EVALUATION">ارزیابی دوره / عمومی</option>
                  <option value="PRE_ASSESSMENT">پیش‌ارزیابی (Pre-Assessment)</option>
                </select>
              </div>
              <div>
                <Label>عنوان فرم *</Label>
                <Input
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  placeholder="مثال: نظرسنجی پایان دوره یا فرم ارزیابی"
                  required
                />
              </div>
              <div>
                <Label>نامک انگلیسی (Slug) - اختیاری</Label>
                <Input
                  value={slug}
                  onChange={(e) => setSlug(e.target.value)}
                  placeholder="مثال: feedback-phase-1"
                />
              </div>
            </div>
            <div>
              <Label>توضیحات فرم</Label>
              <Textarea
                rows={2}
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                placeholder="توضیحاتی که به کاربر بالای فرم نمایش داده می‌شود..."
              />
            </div>
            <div className="flex justify-end gap-2">
              <Button type="button" variant="ghost" onClick={() => setShowCreate(false)}>
                انصراف
              </Button>
              <Button type="submit" disabled={submitting}>
                {submitting ? "در حال ایجاد..." : "ذخیره و ورود به سازنده"}
              </Button>
            </div>
          </form>
        </Card>
      )}

      {forms.length === 0 ? (
        <Card className="py-12 text-center">
          <p className="text-sm opacity-60">هنوز فرمی ایجاد نشده است.</p>
          <Button variant="ghost" className="mt-4 text-xs" onClick={() => setShowCreate(true)}>
            همین حالا اولین فرم را بسازید
          </Button>
        </Card>
      ) : (
        <div className="grid gap-4">
          {forms.map((form) => (
            <Card key={form.id} className="flex flex-col justify-between gap-4 md:flex-row md:items-center">
              <div className="space-y-1">
                <div className="flex items-center gap-2">
                  <span className="font-bold">{form.title}</span>
                  <span
                    className="rounded-full px-2 py-0.5 text-xs font-semibold"
                    style={{
                      backgroundColor: STATUS_LABEL[form.status]?.color || "var(--surface)",
                      color: form.status === "ACTIVE" ? "var(--bg)" : "var(--text)",
                    }}
                  >
                    {STATUS_LABEL[form.status]?.label || form.status}
                  </span>
                  {form.type === "PRE_ASSESSMENT" && (
                    <span className="rounded-full bg-purple-500/15 px-2 py-0.5 text-xs font-semibold text-purple-400 border border-purple-500/30">
                      پیش‌ارزیابی
                    </span>
                  )}
                </div>
                {form.description && (
                  <p className="line-clamp-2 text-xs opacity-70">{form.description}</p>
                )}
                <div className="flex flex-wrap items-center gap-4 text-xs opacity-50">
                  <span>نامک: {form.slug}</span>
                  <span>تعداد سوالات: {form.questions?.length ?? 0}</span>
                  <span>
                    تاریخ ایجاد: {new Date(form.createdAt).toLocaleDateString("fa-IR")}
                  </span>
                </div>
              </div>

              <div className="flex flex-wrap items-center gap-2">
                <a
                  href={`/forms/${form.slug}`}
                  target="_blank"
                  rel="noreferrer"
                  className="rounded-full px-3 py-1.5 text-xs font-medium"
                  style={{ backgroundColor: "var(--surface)", color: "var(--text)" }}
                >
                  مشاهده لینک عمومی ↗
                </a>
                <Link to={`/dashboard/admin/forms/${form.id}`}>
                  <Button variant="primary" className="text-xs">
                    ویرایش و سوالات ⚙
                  </Button>
                </Link>
                <Button
                  variant="ghost"
                  className="text-xs"
                  onClick={() => handleToggleStatus(form)}
                >
                  {form.status === "ACTIVE" ? "غیرفعال‌سازی" : "انتشار فرم"}
                </Button>
                <Button
                  variant="ghost"
                  className="text-xs"
                  onClick={() => handleDuplicate(form.id)}
                  title="کپی از این فرم"
                >
                  کپی
                </Button>
                <Button
                  variant="ghost"
                  className="text-xs text-red-400 hover:text-red-500"
                  onClick={() => handleDelete(form.id, form.title)}
                >
                  حذف
                </Button>
              </div>
            </Card>
          ))}
        </div>
      )}
    </div>
  );
}
