import { RichTextEditor } from "../../components/RichTextEditor";
import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
  Bootcamp,
  BootcampDetail,
  BootcampInput,
  addBootcampQuestion,
  attachQuestionToBootcamp,
  createBootcamp,
  getBootcamp,
  listBootcamps,
  setBootcampStatus,
  updateBootcamp,
  uploadBootcampMedia,
  getBootcampAccessList,
  toggleBootcampAccess,
  ParticipantAccessItem,
} from "../../api/bootcamps";
import { createTask } from "../../api/tasks";
import { JourneySection, listJourneySections } from "../../api/journey";
import { Situation, listSituations } from "../../api/situations";
import { OptionsEditor } from "../../components/OptionsEditor";
import { QuestionBankPicker } from "../../components/QuestionBankPicker";
import { Button, Card, ErrorText, Input, Label, LoadError, Spinner, Textarea } from "../../components/ui";

const STATUS_OPTIONS: Bootcamp["status"][] = [
  "LOCKED",
  "COMING_SOON",
  "ACTIVE",
  "DEADLINE_APPROACHING",
  "SUBMITTED",
  "COMPLETED",
];

const STATUS_LABEL: Record<Bootcamp["status"], string> = {
  LOCKED: "قفل‌شده",
  COMING_SOON: "به‌زودی",
  ACTIVE: "فعال",
  DEADLINE_APPROACHING: "مهلت رو به پایان",
  SUBMITTED: "ثبت‌شده",
  COMPLETED: "تکمیل‌شده",
};

function toDatetimeLocal(iso?: string) {
  if (!iso) return "";
  return new Date(iso).toISOString().slice(0, 16);
}

function emptyForm(): BootcampInput {
  const now = new Date();
  const iso = now.toISOString().slice(0, 16);
  return {
    title: "",
    description: "",
    instructor: "",
    date: iso,
    startTime: iso,
    endTime: iso,
    recordingUrl: undefined,
    journeySectionId: undefined,
  };
}

function BootcampForm({
  sections,
  initial,
  onSubmit,
  onCancel,
  submitting,
}: {
  sections: JourneySection[];
  initial: BootcampInput;
  onSubmit: (input: BootcampInput) => void;
  onCancel?: () => void;
  submitting: boolean;
}) {
  const [form, setForm] = useState<BootcampInput>(initial);
  const [uploadingCover, setUploadingCover] = useState(false);
  const [uploadingTeaser, setUploadingTeaser] = useState(false);
  const [uploadError, setUploadError] = useState<string | null>(null);

  const set = <K extends keyof BootcampInput>(key: K, value: BootcampInput[K]) =>
    setForm((f) => ({ ...f, [key]: value }));

  const handleCoverUpload = async (file: File) => {
    setUploadingCover(true);
    setUploadError(null);
    try {
      const url = await uploadBootcampMedia(file);
      set("coverImageUrl", url);
    } catch {
      setUploadError("آپلود عکس کاور با خطا مواجه شد.");
    } finally {
      setUploadingCover(false);
    }
  };

  const handleTeaserUpload = async (file: File) => {
    setUploadingTeaser(true);
    setUploadError(null);
    try {
      const url = await uploadBootcampMedia(file);
      set("teaserVideoUrl", url);
    } catch {
      setUploadError("آپلود ویدیوی تیزر با خطا مواجه شد.");
    } finally {
      setUploadingTeaser(false);
    }
  };

  return (
    <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div className="sm:col-span-2">
        <Label>عنوان بوت‌کمپ</Label>
        <Input value={form.title} onChange={(e) => set("title", e.target.value)} />
      </div>
      <div className="sm:col-span-2">
        <Label>توضیحات</Label>
        <RichTextEditor
          content={form.description ?? ""}
          onChange={(val) => set("description", val)}
          placeholder="توضیحات بوت‌کمپ..."
        />
      </div>
      <div>
        <Label>مربی</Label>
        <Input value={form.instructor ?? ""} onChange={(e) => set("instructor", e.target.value)} />
      </div>

      <div>
        <Label>عکس کاور بوت‌کمپ</Label>
        {form.coverImageUrl && (
          <img src={form.coverImageUrl} alt="" className="mb-2 h-24 w-full rounded-lg object-cover" />
        )}
        <input
          type="file"
          accept="image/jpeg,image/png,image/webp"
          disabled={uploadingCover}
          onChange={(e) => e.target.files?.[0] && handleCoverUpload(e.target.files[0])}
          className="text-xs"
        />
        {uploadingCover && <p className="mt-1 text-xs opacity-60">در حال آپلود...</p>}
      </div>

      <div className="sm:col-span-2">
        <Label>لینک دانلود ویدیوی ضبط‌شده (Mega.nz / لینک مستقیم)</Label>
        <Input
          placeholder="https://mega.nz/file/..."
          value={form.recordingUrl ?? ""}
          onChange={(e) => set("recordingUrl", e.target.value || undefined)}
        />
        <p className="mt-1 text-xs opacity-60">این لینک فقط برای شرکت‌کنندگان مجاز و پس از اتمام بوت‌کمپ (COMPLETED) نمایش داده می‌شود.</p>
      </div>

      <div>
        <Label>ویدیوی تیزر بوت‌کمپ (اختیاری)</Label>
        {form.teaserVideoUrl && (
          <video src={form.teaserVideoUrl} controls className="mb-2 h-24 w-full rounded-lg object-cover" />
        )}
        <input
          type="file"
          accept="video/mp4,video/webm,video/quicktime"
          disabled={uploadingTeaser}
          onChange={(e) => e.target.files?.[0] && handleTeaserUpload(e.target.files[0])}
          className="text-xs"
        />
        {uploadingTeaser && <p className="mt-1 text-xs opacity-60">در حال آپلود (ممکن است طول بکشد)...</p>}
      </div>
      <ErrorText>{uploadError}</ErrorText>
      <div>
        <Label>بخش ژورنی مرتبط</Label>
        <select
          className="w-full rounded-lg border px-3 py-2 text-sm"
          style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
          value={form.journeySectionId ?? ""}
          onChange={(e) => set("journeySectionId", e.target.value || undefined)}
        >
          <option value="">— بدون بخش —</option>
          {sections.map((s) => (
            <option key={s.id} value={s.id}>
              {s.title}
            </option>
          ))}
        </select>
      </div>
      <div>
        <Label>تاریخ و ساعت شروع</Label>
        <Input
          type="datetime-local"
          value={toDatetimeLocal(form.startTime) || form.startTime}
          onChange={(e) => set("startTime", e.target.value)}
        />
      </div>
      <div>
        <Label>تاریخ و ساعت پایان</Label>
        <Input
          type="datetime-local"
          value={toDatetimeLocal(form.endTime) || form.endTime}
          onChange={(e) => set("endTime", e.target.value)}
        />
      </div>

      <div className="flex items-center gap-3 sm:col-span-2">
        <Button
          onClick={() => onSubmit({ ...form, date: form.startTime })}
          disabled={submitting || !form.title}
        >
          {submitting ? "در حال ذخیره..." : "ذخیره"}
        </Button>
        {onCancel && (
          <Button variant="ghost" onClick={onCancel}>
            انصراف
          </Button>
        )}
      </div>
    </div>
  );
}

const STAGE_LABEL: Record<string, string> = { BEFORE: "قبل", AFTER: "بعد", REVISION: "بازبینی" };
const INPUT_TYPE_LABEL: Record<string, string> = {
  TEXT: "متن",
  LINK: "لینک",
  PHOTO: "عکس",
  TRAIT_TAG: "برچسب صفت",
  SINGLE_CHOICE: "تستی (تک‌انتخابی)",
  MULTI_CHOICE: "تستی (چندانتخابی)",
};

function ExistingItemsPanel({ bootcampId, refreshKey }: { bootcampId: string; refreshKey: number }) {
  const [detail, setDetail] = useState<BootcampDetail | null>(null);

  useEffect(() => {
    getBootcamp(bootcampId).then(setDetail);
  }, [bootcampId, refreshKey]);

  if (!detail) return null;

  return (
    <div className="space-y-3">
      {detail.questions.length > 0 && (
        <div>
          <div className="mb-1 text-xs opacity-60">سؤالات تعریف‌شده</div>
          <div className="space-y-1">
            {detail.questions.map((q) => (
              <div key={q.id} className="rounded-lg px-3 py-1.5 text-sm" style={{ backgroundColor: "var(--surface)" }}>
                <span className="ml-2 text-xs opacity-60">
                  [{STAGE_LABEL[q.stage] ?? q.stage} · {INPUT_TYPE_LABEL[q.inputType] ?? q.inputType}]
                </span>
                {q.text}
                {q.options && q.options.length > 0 && (
                  <div className="mt-1 text-xs opacity-60">گزینه‌ها: {q.options.join("، ")}</div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
      {detail.tasks.length > 0 && (
        <div>
          <div className="mb-1 text-xs opacity-60">تکالیف تعریف‌شده</div>
          <div className="space-y-1">
            {detail.tasks.map((t) => (
              <div key={t.id} className="rounded-lg px-3 py-1.5 text-sm" style={{ backgroundColor: "var(--surface)" }}>
                {t.title}
              </div>
            ))}
          </div>
        </div>
      )}
      {detail.questions.length === 0 && detail.tasks.length === 0 && (
        <p className="text-xs opacity-60">هنوز سؤال یا تکلیفی تعریف نشده است.</p>
      )}
    </div>
  );
}

function TaskAdder({ bootcampId, onAdded }: { bootcampId: string; onAdded: () => void }) {
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [saving, setSaving] = useState(false);
  const [added, setAdded] = useState(false);

  const submit = async () => {
    if (!title.trim()) return;
    setSaving(true);
    try {
      await createTask(bootcampId, { title, description: description || undefined });
      setTitle("");
      setDescription("");
      setAdded(true);
      onAdded();
      setTimeout(() => setAdded(false), 2000);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="mt-3 flex flex-wrap items-center gap-2 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
      <Input
        className="flex-1"
        placeholder="عنوان تکلیف..."
        value={title}
        onChange={(e) => setTitle(e.target.value)}
      />
      <Input
        className="flex-1"
        placeholder="توضیح (اختیاری)..."
        value={description}
        onChange={(e) => setDescription(e.target.value)}
      />
      <Button onClick={submit} disabled={saving || !title.trim()}>
        {added ? "افزوده شد ✓" : "افزودن تکلیف"}
      </Button>
    </div>
  );
}

function QuestionAdder({
  bootcampId,
  onAdded,
  situations,
}: {
  bootcampId: string;
  onAdded: () => void;
  situations: Situation[];
}) {
  const [text, setText] = useState("");
  const [stage, setStage] = useState<"BEFORE" | "AFTER">("BEFORE");
  const [inputType, setInputType] = useState<
    "TEXT" | "LINK" | "PHOTO" | "TRAIT_TAG" | "SINGLE_CHOICE" | "MULTI_CHOICE"
  >("TEXT");
  const [situationId, setSituationId] = useState("");
  const [options, setOptions] = useState<string[]>(["", ""]);
  const [saving, setSaving] = useState(false);
  const [added, setAdded] = useState(false);

  const isChoice = inputType === "SINGLE_CHOICE" || inputType === "MULTI_CHOICE";
  const validOptions = options.map((o) => o.trim()).filter(Boolean);

  const submit = async () => {
    if (!text.trim()) return;
    if (inputType === "TRAIT_TAG" && !situationId) return;
    if (isChoice && validOptions.length < 2) return;
    setSaving(true);
    try {
      await addBootcampQuestion(bootcampId, {
        text,
        stage,
        inputType,
        situationId: inputType === "TRAIT_TAG" ? situationId : undefined,
        options: isChoice ? validOptions : undefined,
      });
      setText("");
      setOptions(["", ""]);
      setAdded(true);
      onAdded();
      setTimeout(() => setAdded(false), 2000);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="mt-3 flex flex-wrap items-center gap-2 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
      <select
        className="rounded-lg border px-2 py-1.5 text-xs"
        style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
        value={stage}
        onChange={(e) => setStage(e.target.value as "BEFORE" | "AFTER")}
      >
        <option value="BEFORE">قبل</option>
        <option value="AFTER">بعد</option>
      </select>
      <select
        className="rounded-lg border px-2 py-1.5 text-xs"
        style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
        value={inputType}
        onChange={(e) => setInputType(e.target.value as typeof inputType)}
      >
        <option value="TEXT">متن</option>
        <option value="LINK">لینک</option>
        <option value="PHOTO">عکس</option>
        <option value="TRAIT_TAG">برچسب صفت (موقعیتی)</option>
        <option value="SINGLE_CHOICE">تستی — تک‌انتخابی</option>
        <option value="MULTI_CHOICE">تستی — چندانتخابی</option>
      </select>
      {inputType === "TRAIT_TAG" && (
        <select
          className="rounded-lg border px-2 py-1.5 text-xs"
          style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
          value={situationId}
          onChange={(e) => setSituationId(e.target.value)}
        >
          <option value="">— انتخاب موقعیت —</option>
          {situations.map((s) => (
            <option key={s.id} value={s.id}>
              {s.title}
            </option>
          ))}
        </select>
      )}
      <Input
        className="flex-1"
        placeholder="متن سؤال..."
        value={text}
        onChange={(e) => setText(e.target.value)}
      />
      {isChoice && <OptionsEditor options={options} onChange={setOptions} />}
      <Button
        onClick={submit}
        disabled={
          saving ||
          !text.trim() ||
          (inputType === "TRAIT_TAG" && !situationId) ||
          (isChoice && validOptions.length < 2)
        }
      >
        {added ? "افزوده شد ✓" : "افزودن سؤال"}
      </Button>
    </div>
  );
}


function AccessManagementPanel({ bootcampId }: { bootcampId: string }) {
  const [participants, setParticipants] = useState<ParticipantAccessItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [updatingId, setUpdatingId] = useState<string | null>(null);
  const [bulkLoading, setBulkLoading] = useState(false);
  const [errorMsg, setErrorMsg] = useState("");

  const loadList = () => {
    setLoading(true);
    getBootcampAccessList(bootcampId)
      .then((data) => {
        setParticipants(data || []);
        setErrorMsg("");
      })
      .catch((err) => {
        setErrorMsg(err?.response?.data?.message || "خطا در دریافت لیست دسترسی‌ها");
      })
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    loadList();
  }, [bootcampId]);

  const handleToggle = async (userId: string, currentAccess: boolean) => {
    setUpdatingId(userId);
    try {
      await toggleBootcampAccess(bootcampId, userId, !currentAccess);
      setParticipants((prev) =>
        prev.map((p) => (p.userId === userId ? { ...p, hasAccess: !currentAccess } : p))
      );
    } catch (err: any) {
      alert(err?.response?.data?.message || "خطا در تغییر وضعیت دسترسی");
    } finally {
      setUpdatingId(null);
    }
  };

  const handleBulk = async (grant: boolean) => {
    if (!confirm(grant ? "آیا به تمام کاربران دسترسی داده شود؟" : "آیا دسترسی تمام کاربران لغو شود؟")) return;
    setBulkLoading(true);
    try {
      const targets = participants.filter((p) => p.hasAccess !== grant);
      for (const p of targets) {
        await toggleBootcampAccess(bootcampId, p.userId, grant);
      }
      setParticipants((prev) => prev.map((p) => ({ ...p, hasAccess: grant })));
    } catch (err: any) {
      alert("خطا در اعمال دسترسی همگانی");
    } finally {
      setBulkLoading(false);
    }
  };

  const filtered = participants.filter(
    (p) =>
      p.fullName.toLowerCase().includes(search.toLowerCase()) ||
      p.email.toLowerCase().includes(search.toLowerCase())
  );

  const grantedCount = participants.filter((p) => p.hasAccess).length;

  return (
    <div className="mt-4 rounded-xl border p-4" style={{ borderColor: "var(--surface)", backgroundColor: "rgba(255,255,255,0.02)" }}>
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div>
          <h3 className="text-sm font-bold">مدیریت دسترسی دانلود ویدیو</h3>
          <p className="text-xs opacity-60 mt-0.5">
            {participants.length} شرکت‌کننده | {grantedCount} نفر دارای دسترسی
          </p>
        </div>
        <div className="flex items-center gap-2">
          <Button variant="ghost" disabled={bulkLoading || loading} onClick={() => handleBulk(true)}>
            دسترسی به همه
          </Button>
          <Button variant="ghost" disabled={bulkLoading || loading} onClick={() => handleBulk(false)}>
            لغو همه
          </Button>
        </div>
      </div>

      <div className="mb-3">
        <Input
          placeholder="جستجوی نام یا ایمیل شرکت‌کننده..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />
      </div>

      {errorMsg && <p className="text-xs text-red-500 mb-2">{errorMsg}</p>}

      {loading ? (
        <div className="py-6 flex justify-center">
          <Spinner />
        </div>
      ) : filtered.length === 0 ? (
        <p className="text-xs opacity-50 py-3 text-center">شرکت‌کننده‌ای یافت نشد.</p>
      ) : (
        <div className="max-h-72 overflow-y-auto space-y-2 pr-1">
          {filtered.map((p) => (
            <div
              key={p.userId}
              className="flex items-center justify-between p-2.5 rounded-lg border text-xs"
              style={{ borderColor: "var(--surface)", backgroundColor: "var(--surface)" }}
            >
              <div>
                <span className="font-semibold">{p.fullName}</span>
                <span className="opacity-50 mx-2">({p.email})</span>
              </div>
              <label className="flex items-center gap-2 cursor-pointer select-none">
                <input
                  type="checkbox"
                  checked={p.hasAccess}
                  disabled={updatingId === p.userId || bulkLoading}
                  onChange={() => handleToggle(p.userId, p.hasAccess)}
                  className="rounded border-[var(--accent)] accent-[var(--accent)] h-4 w-4"
                />
                <span className={p.hasAccess ? "text-emerald-400 font-medium" : "opacity-60"}>
                  {p.hasAccess ? "مجاز به دانلود" : "مسدود"}
                </span>
              </label>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

export function AdminBootcampsPage() {
  const [bootcamps, setBootcamps] = useState<Bootcamp[] | null>(null);
  const [sections, setSections] = useState<JourneySection[]>([]);
  const [situations, setSituations] = useState<Situation[]>([]);
  const [creating, setCreating] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [expandedId, setExpandedId] = useState<string | null>(null);
  const [accessBootcampId, setAccessBootcampId] = useState<string | null>(null);
  const [refreshKey, setRefreshKey] = useState(0);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [loadError, setLoadError] = useState<string | null>(null);

  const reload = () => {
    setLoadError(null);
    listBootcamps()
      .then(setBootcamps)
      .catch(() => setLoadError("بارگذاری بوت‌کمپ‌ها با خطا مواجه شد."));
  };

  useEffect(() => {
    reload();
    listJourneySections().then(setSections).catch(() => {});
    listSituations().then(setSituations).catch(() => {});
  }, []);

  const handleCreate = async (input: BootcampInput) => {
    setSaving(true);
    setError(null);
    try {
      await createBootcamp(input);
      setCreating(false);
      reload();
    } catch {
      setError("ساخت بوت‌کمپ با خطا مواجه شد.");
    } finally {
      setSaving(false);
    }
  };

  const handleUpdate = async (id: string, input: BootcampInput) => {
    setSaving(true);
    setError(null);
    try {
      await updateBootcamp(id, input);
      setEditingId(null);
      reload();
    } catch {
      setError("ویرایش بوت‌کمپ با خطا مواجه شد.");
    } finally {
      setSaving(false);
    }
  };

  const handleStatusChange = async (id: string, status: Bootcamp["status"]) => {
    await setBootcampStatus(id, status);
    reload();
  };

  if (loadError) return <LoadError message={loadError} onRetry={reload} />;

  if (!bootcamps) {
    return (
      <div className="flex justify-center py-16">
        <Spinner />
      </div>
    );
  }

  return (
    <div>
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">مدیریت بوت‌کمپ‌ها / آکادمی</h1>
        {!creating && <Button onClick={() => setCreating(true)}>+ بوت‌کمپ جدید</Button>}
      </div>

      {creating && (
        <Card className="mt-4">
          <h2 className="mb-3 text-sm font-semibold">بوت‌کمپ جدید</h2>
          <BootcampForm
            sections={sections}
            initial={emptyForm()}
            onSubmit={handleCreate}
            onCancel={() => setCreating(false)}
            submitting={saving}
          />
        </Card>
      )}

      <ErrorText>{error}</ErrorText>

      <div className="mt-6 space-y-3">
        {bootcamps.map((b) => (
          <Card key={b.id}>
            {editingId === b.id ? (
              <BootcampForm
                sections={sections}
                initial={{
                  title: b.title,
                  description: b.description ?? "",
                  instructor: b.instructor ?? "",
                  coverImageUrl: b.coverImageUrl ?? undefined,
                  teaserVideoUrl: b.teaserVideoUrl ?? undefined,
                  recordingUrl: b.recordingUrl ?? undefined,
                  date: b.date,
                  startTime: b.startTime,
                  endTime: b.endTime,
                  journeySectionId: b.journeySection?.id,
                }}
                onSubmit={(input) => handleUpdate(b.id, input)}
                onCancel={() => setEditingId(null)}
                submitting={saving}
              />
            ) : (
              <>
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <div className="font-semibold">{b.title}</div>
                    <div className="mt-1 text-xs opacity-60">
                      {new Date(b.date).toLocaleDateString("fa-IR")}
                      {b.journeySection && ` · ${b.journeySection.title}`}
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <select
                      className="rounded-lg border px-2 py-1.5 text-xs"
                      style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
                      value={b.status}
                      onChange={(e) => handleStatusChange(b.id, e.target.value as Bootcamp["status"])}
                    >
                      {STATUS_OPTIONS.map((s) => (
                        <option key={s} value={s}>
                          {STATUS_LABEL[s]}
                        </option>
                      ))}
                    </select>
                    <Button variant="ghost" onClick={() => setEditingId(b.id)}>
                      ویرایش
                    </Button>
                    <Link to={`/dashboard/manager/bootcamps/${b.id}/live`}>
                      <Button variant="ghost">جلسه‌ی زنده</Button>
                    </Link>
                    <Button
                      variant="ghost"
                      onClick={() => setExpandedId(expandedId === b.id ? null : b.id)}
                    >
                      {expandedId === b.id ? "بستن سؤالات" : "سؤالات"}
                    </Button>
                    <Button
                      variant="ghost"
                      onClick={() => setAccessBootcampId(accessBootcampId === b.id ? null : b.id)}
                    >
                      {accessBootcampId === b.id ? "بستن دسترسی‌ها" : "دسترسی‌ها"}
                    </Button>
                  </div>
                </div>
                                {accessBootcampId === b.id && (
                  <AccessManagementPanel bootcampId={b.id} />
                )}
                {expandedId === b.id && (
                  <div className="mt-3 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
                    <ExistingItemsPanel bootcampId={b.id} refreshKey={refreshKey} />
                    <QuestionAdder bootcampId={b.id} onAdded={() => setRefreshKey((k) => k + 1)} situations={situations} />
                    <div className="mt-2">
                      <QuestionBankPicker
                        onAttach={(questionId) =>
                          attachQuestionToBootcamp(b.id, questionId).then(() => setRefreshKey((k) => k + 1))
                        }
                      />
                    </div>
                    <TaskAdder bootcampId={b.id} onAdded={() => setRefreshKey((k) => k + 1)} />
                  </div>
                )}
              </>
            )}
          </Card>
        ))}
        {bootcamps.length === 0 && !creating && (
          <p className="text-sm opacity-60">هنوز بوت‌کمپی ساخته نشده — یکی بسازید.</p>
        )}
      </div>
    </div>
  );
}
