import { useEffect, useState } from "react";
import {
  JourneySection,
  JourneySectionDetail,
  attachQuestionToSection,
  createJourneySection,
  createSectionQuestion,
  deleteJourneySection,
  getJourneySection,
  listJourneySections,
  updateJourneySection,
} from "../../api/journey";
import { Situation, listSituations } from "../../api/situations";
import { listParticipants, AdminParticipant } from "../../api/admin";
import { listParticipantResponses, ResponseWithVersions } from "../../api/responses";
import { OptionsEditor } from "../../components/OptionsEditor";
import { QuestionBankPicker } from "../../components/QuestionBankPicker";
import { Button, Card, ErrorText, Input, LoadError, Spinner, Textarea } from "../../components/ui";

const INPUT_TYPE_LABEL: Record<string, string> = {
  TEXT: "متن",
  LINK: "لینک",
  PHOTO: "عکس",
  TRAIT_TAG: "برچسب صفت",
  SINGLE_CHOICE: "تستی (تک‌انتخابی)",
  MULTI_CHOICE: "تستی (چندانتخابی)",
};

const STAGE_LABEL: Record<string, string> = {
  BEFORE: "قبل از آموزش",
  AFTER: "بعد از آموزش",
  REVISION: "بازبینی و اصلاح",
};

type QInputType = "TEXT" | "LINK" | "PHOTO" | "TRAIT_TAG" | "SINGLE_CHOICE" | "MULTI_CHOICE";

function SectionPanel({ section, situations }: { section: JourneySection; situations: Situation[] }) {
  const [detail, setDetail] = useState<JourneySectionDetail | null>(null);
  const [text, setText] = useState("");
  const [inputType, setInputType] = useState<QInputType>("TEXT");
  const [situationId, setSituationId] = useState("");
  const [options, setOptions] = useState<string[]>(["", ""]);
  const [saving, setSaving] = useState(false);
  const [added, setAdded] = useState(false);

  const isChoice = inputType === "SINGLE_CHOICE" || inputType === "MULTI_CHOICE";
  const validOptions = options.map((o) => o.trim()).filter(Boolean);

  const reload = () => {
    getJourneySection(section.id).then(setDetail);
  };

  useEffect(reload, [section.id]);

  const submit = async () => {
    if (!text.trim()) return;
    if (inputType === "TRAIT_TAG" && !situationId) return;
    if (isChoice && validOptions.length < 2) return;
    setSaving(true);
    try {
      await createSectionQuestion(section.id, {
        text: text.trim(),
        inputType,
        situationId: inputType === "TRAIT_TAG" ? situationId : undefined,
        options: isChoice ? validOptions : undefined,
      });
      setText("");
      setOptions(["", ""]);
      setAdded(true);
      reload();
      setTimeout(() => setAdded(false), 2000);
    } finally {
      setSaving(false);
    }
  };

  return (
    <Card>
      <div className="font-semibold">{section.title}</div>
      {section.description && <p className="mt-1 text-xs opacity-60">{section.description}</p>}

      {detail && detail.questions.length > 0 && (
        <div className="mt-3 space-y-1 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
          {detail.questions.map((q) => (
            <div key={q.id} className="rounded-lg px-3 py-1.5 text-sm" style={{ backgroundColor: "var(--surface)" }}>
              <span className="ml-2 text-xs opacity-60">[{INPUT_TYPE_LABEL[q.inputType]}]</span>
              {q.text}
              {q.options && q.options.length > 0 && (
                <div className="mt-1 text-xs opacity-60">گزینه‌ها: {q.options.join("، ")}</div>
              )}
            </div>
          ))}
        </div>
      )}

      <div className="mt-3 flex flex-wrap items-center gap-2 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
        <select
          className="rounded-lg border px-2 py-1.5 text-xs"
          style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
          value={inputType}
          onChange={(e) => setInputType(e.target.value as QInputType)}
        >
          <option value="TEXT">متن</option>
          <option value="LINK">لینک</option>
          <option value="PHOTO">عکس</option>
          <option value="TRAIT_TAG">برچسب صفت (موقعیتی)</option>
          <option value="SINGLE_CHOICE">تستی — تک‌انتخابی</option>
          <option value="MULTI_CHOICE">تستی — چندانتخابی</option>
        </select>
        {inputType === "TRAIT_TAG" && (
          <select
            className="rounded-lg border px-2 py-1.5 text-xs"
            style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
            value={situationId}
            onChange={(e) => setSituationId(e.target.value)}
          >
            <option value="">— انتخاب موقعیت —</option>
            {situations.map((s) => (
              <option key={s.id} value={s.id}>
                {s.title}
              </option>
            ))}
          </select>
        )}
        <Input
          className="flex-1"
          placeholder="متن سؤال یا درخواست..."
          value={text}
          onChange={(e) => setText(e.target.value)}
        />
        {isChoice && <OptionsEditor options={options} onChange={setOptions} />}
        <Button
          onClick={submit}
          disabled={
            saving ||
            !text.trim() ||
            (inputType === "TRAIT_TAG" && !situationId) ||
            (isChoice && validOptions.length < 2)
          }
        >
          {added ? "افزوده شد ✓" : "افزودن"}
        </Button>
      </div>

      <div className="mt-2">
        <QuestionBankPicker onAttach={(questionId) => attachQuestionToSection(section.id, questionId).then(reload)} />
      </div>
    </Card>
  );
}

function SectionsManager({
  sections,
  onChanged,
}: {
  sections: JourneySection[];
  onChanged: () => void;
}) {
  const [adding, setAdding] = useState(false);
  const [newKey, setNewKey] = useState("");
  const [newTitle, setNewTitle] = useState("");
  const [newDescription, setNewDescription] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [editTitle, setEditTitle] = useState("");
  const [editDescription, setEditDescription] = useState("");
  const [editOrder, setEditOrder] = useState(0);

  const startAdd = async () => {
    if (!newKey.trim() || !newTitle.trim()) return;
    setError(null);
    try {
      await createJourneySection({
        key: newKey.trim(),
        title: newTitle.trim(),
        description: newDescription.trim() || undefined,
      });
      setNewKey("");
      setNewTitle("");
      setNewDescription("");
      setAdding(false);
      onChanged();
    } catch {
      setError("ساخت بخش جدید با خطا مواجه شد — شاید این شناسه (key) قبلاً استفاده شده.");
    }
  };

  const startEdit = (s: JourneySection) => {
    setEditingId(s.id);
    setEditTitle(s.title);
    setEditDescription(s.description ?? "");
    setEditOrder(s.order);
  };

  const saveEdit = async () => {
    if (!editingId) return;
    setError(null);
    try {
      await updateJourneySection(editingId, {
        title: editTitle.trim(),
        description: editDescription.trim() || undefined,
        order: editOrder,
      });
      setEditingId(null);
      onChanged();
    } catch {
      setError("ویرایش بخش با خطا مواجه شد.");
    }
  };

  const remove = async (id: string) => {
    if (!confirm("این بخش حذف شود؟ فقط در صورتی ممکن است که هیچ سؤال یا بوت‌کمپی به آن وصل نباشد.")) return;
    setError(null);
    try {
      await deleteJourneySection(id);
      onChanged();
    } catch {
      setError("این بخش سؤال یا بوت‌کمپ متصل دارد و قابل حذف نیست.");
    }
  };

  return (
    <Card className="mt-4">
      <h2 className="mb-2 text-sm font-semibold">بخش‌های مسیر برند (نقاط نقشه راه)</h2>
      <div className="space-y-2">
        {sections.map((s) => (
          <div key={s.id} className="rounded-lg p-2" style={{ backgroundColor: "var(--surface)" }}>
            {editingId === s.id ? (
              <div className="space-y-2">
                <Input value={editTitle} onChange={(e) => setEditTitle(e.target.value)} placeholder="عنوان" />
                <Textarea
                  rows={2}
                  value={editDescription}
                  onChange={(e) => setEditDescription(e.target.value)}
                  placeholder="توضیح (اختیاری)"
                />
                <Input
                  type="number"
                  value={editOrder}
                  onChange={(e) => setEditOrder(Number(e.target.value))}
                  placeholder="ترتیب"
                  className="max-w-[100px]"
                />
                <div className="flex gap-2">
                  <Button onClick={saveEdit}>ذخیره</Button>
                  <Button variant="ghost" onClick={() => setEditingId(null)}>
                    انصراف
                  </Button>
                </div>
              </div>
            ) : (
              <div className="flex items-start justify-between gap-2">
                <div>
                  <p className="text-sm font-medium">
                    {s.order}. {s.title} <span className="opacity-50">({s.key})</span>
                  </p>
                  {s.description && <p className="text-xs opacity-60">{s.description}</p>}
                </div>
                <div className="flex shrink-0 gap-2">
                  <button className="text-xs opacity-70 hover:opacity-100" onClick={() => startEdit(s)}>
                    ویرایش
                  </button>
                  <button className="text-xs opacity-70 hover:opacity-100" onClick={() => remove(s.id)}>
                    حذف
                  </button>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      {adding ? (
        <div className="mt-3 space-y-2 rounded-lg p-2" style={{ backgroundColor: "var(--surface)" }}>
          <Input value={newKey} onChange={(e) => setNewKey(e.target.value)} placeholder="شناسه (key) — مثلاً identity" />
          <Input value={newTitle} onChange={(e) => setNewTitle(e.target.value)} placeholder="عنوان بخش" />
          <Textarea
            rows={2}
            value={newDescription}
            onChange={(e) => setNewDescription(e.target.value)}
            placeholder="توضیح (اختیاری)"
          />
          <div className="flex gap-2">
            <Button onClick={startAdd}>افزودن بخش</Button>
            <Button variant="ghost" onClick={() => setAdding(false)}>
              انصراف
            </Button>
          </div>
        </div>
      ) : (
        <Button className="mt-3" variant="ghost" onClick={() => setAdding(true)}>
          + بخش جدید
        </Button>
      )}
      <ErrorText>{error}</ErrorText>
    </Card>
  );
}

function ParticipantAnswersViewer({ sections }: { sections: JourneySection[] }) {
  const [participants, setParticipants] = useState<AdminParticipant[]>([]);
  const [selectedParticipantId, setSelectedParticipantId] = useState<string>("");
  const [search, setSearch] = useState("");
  const [responses, setResponses] = useState<ResponseWithVersions[] | null>(null);
  const [loadingResponses, setLoadingResponses] = useState(false);
  const [selectedSectionId, setSelectedSectionId] = useState<string>("ALL");

  useEffect(() => {
    listParticipants({}).then((data) => {
      setParticipants(data);
      if (data.length > 0) {
        setSelectedParticipantId(data[0].id);
      }
    });
  }, []);

  useEffect(() => {
    if (!selectedParticipantId) return;
    setLoadingResponses(true);
    listParticipantResponses(selectedParticipantId)
      .then(setResponses)
      .catch(() => setResponses([]))
      .finally(() => setLoadingResponses(false));
  }, [selectedParticipantId]);

  const filteredParticipants = participants.filter((p) => {
    const full = `${p.firstName} ${p.lastName} ${p.city || ""} ${p.slug || ""}`.toLowerCase();
    return full.includes(search.toLowerCase());
  });

  const selectedParticipant = participants.find((p) => p.id === selectedParticipantId);

  const filteredResponses = (responses || []).filter((r) => {
    if (selectedSectionId === "ALL") return true;
    return r.question.journeySectionId === selectedSectionId;
  });

  return (
    <div className="mt-4 space-y-4">
      <Card>
        <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div className="flex-1">
            <label className="text-xs font-semibold opacity-70">انتخاب شرکت‌کننده:</label>
            <div className="mt-1 flex gap-2">
              <Input
                className="max-w-[200px]"
                placeholder="جستجوی نام یا ایمیل..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
              />
              <select
                className="flex-1 rounded-lg border px-3 py-2 text-sm"
                style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
                value={selectedParticipantId}
                onChange={(e) => setSelectedParticipantId(e.target.value)}
              >
                {filteredParticipants.map((p) => (
                  <option key={p.id} value={p.id}>
                    {p.firstName} {p.lastName} ({p.city || p.slug}) — {p.responseCount} پاسخ
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label className="text-xs font-semibold opacity-70">فیلتر بخش مسیر:</label>
            <select
              className="mt-1 block w-full rounded-lg border px-3 py-2 text-sm"
              style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)", color: "var(--text)" }}
              value={selectedSectionId}
              onChange={(e) => setSelectedSectionId(e.target.value)}
            >
              <option value="ALL">همه بخش‌های مسیر</option>
              {sections.map((s) => (
                <option key={s.id} value={s.id}>
                  {s.order}. {s.title}
                </option>
              ))}
            </select>
          </div>
        </div>
      </Card>

      {loadingResponses ? (
        <div className="flex justify-center py-12">
          <Spinner />
        </div>
      ) : !selectedParticipant ? (
        <Card className="text-center py-8 opacity-60">هیچ شرکت‌کننده‌ای یافت نشد.</Card>
      ) : filteredResponses.length === 0 ? (
        <Card className="text-center py-8 opacity-60">
          برای {selectedParticipant.firstName} {selectedParticipant.lastName} در این بخش هنوز پاسخی ثبت نشده است.
        </Card>
      ) : (
        <div className="space-y-4">
          {filteredResponses.map((r) => {
            const section = sections.find((s) => s.id === r.question.journeySectionId);
            return (
              <Card key={r.id} className="space-y-3">
                <div className="flex items-start justify-between border-b pb-2" style={{ borderColor: "var(--surface)" }}>
                  <div>
                    <span className="text-xs font-semibold px-2 py-0.5 rounded mr-2" style={{ backgroundColor: "var(--surface)", color: "var(--accent)" }}>
                      {section ? section.title : "عمومی"}
                    </span>
                    <h3 className="mt-1 font-semibold text-sm">{r.question.text}</h3>
                  </div>
                  <span className="text-xs font-medium px-2 py-1 rounded bg-blue-500/10 text-blue-500">
                    {r.versions.length} نسخه ثبت‌شده
                  </span>
                </div>

                {/* تایم‌لاین تمام نسخه‌ها */}
                <div className="space-y-3 pt-1">
                  {r.versions.map((v, idx) => {
                    const isPhoto = v.content.startsWith("http") && (v.content.endsWith(".jpg") || v.content.endsWith(".png") || v.content.endsWith(".jpeg") || v.content.endsWith(".webp") || v.content.includes("/uploads/"));
                    return (
                      <div
                        key={v.id}
                        className="relative rounded-lg p-3 border"
                        style={{
                          backgroundColor: idx === r.versions.length - 1 ? "rgba(var(--accent-rgb, 59, 130, 246), 0.05)" : "var(--surface)",
                          borderColor: idx === r.versions.length - 1 ? "var(--accent)" : "transparent",
                        }}
                      >
                        <div className="flex items-center justify-between text-xs opacity-70 mb-2 border-b pb-1" style={{ borderColor: "rgba(255,255,255,0.05)" }}>
                          <span className="font-bold text-sm" style={{ color: "var(--accent)" }}>
                            نسخه {v.versionNumber} {idx === r.versions.length - 1 && "(آخرین پاسخ)"}
                          </span>
                          <div className="flex items-center gap-3">
                            <span className="px-1.5 py-0.5 rounded text-[11px] bg-neutral-500/20">
                              مرحله: {STAGE_LABEL[v.stage] || v.stage}
                            </span>
                            <span>
                              {new Date(v.createdAt).toLocaleDateString("fa-IR", {
                                year: "numeric",
                                month: "short",
                                day: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                              })}
                            </span>
                          </div>
                        </div>

                        {isPhoto ? (
                          <div className="mt-2 flex flex-col gap-2">
                            <a href={v.content} target="_blank" rel="noreferrer" className="block max-w-sm">
                              <img
                                src={v.content}
                                alt={`پاسخ نسخه ${v.versionNumber}`}
                                className="rounded-lg border object-cover max-h-60 w-auto hover:opacity-90 transition-opacity"
                                style={{ borderColor: "var(--surface)" }}
                              />
                            </a>
                            <a href={v.content} target="_blank" rel="noreferrer" className="text-xs underline opacity-70 hover:opacity-100">
                              مشاهده یا دانلود تصویر در تب جدید ↗
                            </a>
                          </div>
                        ) : (
                          <p className="whitespace-pre-wrap text-sm leading-relaxed mt-1">
                            {v.content}
                          </p>
                        )}

                        {v.autoScore !== null && v.autoScore !== undefined && (
                          <div className="mt-2 text-xs font-semibold text-emerald-500">
                            امتیاز خودکار: {v.autoScore}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </Card>
            );
          })}
        </div>
      )}
    </div>
  );
}

export function AdminJourneyPage() {
  const [activeTab, setActiveTab] = useState<"ANSWERS" | "STRUCTURE">("ANSWERS");
  const [sections, setSections] = useState<JourneySection[] | null>(null);
  const [situations, setSituations] = useState<Situation[]>([]);
  const [loadError, setLoadError] = useState<string | null>(null);

  const reload = () => {
    setLoadError(null);
    listJourneySections()
      .then(setSections)
      .catch(() => setLoadError("بارگذاری بخش‌های مسیر برند با خطا مواجه شد."));
    listSituations().then(setSituations).catch(() => {});
  };

  useEffect(reload, []);

  if (loadError) return <LoadError message={loadError} onRetry={reload} />;

  if (!sections) {
    return (
      <div className="flex justify-center py-16">
        <Spinner />
      </div>
    );
  }

  return (
    <div className="mx-auto max-w-4xl">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold">مدیریت و پایش مسیر برند</h1>
          <p className="mt-1 text-sm opacity-70">
            مشاهده پاسخ‌ها و نسخه‌های ثبت‌شده شرکت‌کنندگان یا ویرایش ساختار سوالات مسیر
          </p>
        </div>
      </div>

      {/* Tabs */}
      <div className="mt-6 flex border-b" style={{ borderColor: "var(--surface)" }}>
        <button
          onClick={() => setActiveTab("ANSWERS")}
          className={`px-4 py-2 text-sm font-semibold border-b-2 transition-all ${
            activeTab === "ANSWERS"
              ? "border-[var(--accent)] text-[var(--accent)]"
              : "border-transparent opacity-60 hover:opacity-100"
          }`}
        >
          🔍 پاسخ‌های شرکت‌کنندگان و تاریخچه نسخه‌ها
        </button>
        <button
          onClick={() => setActiveTab("STRUCTURE")}
          className={`px-4 py-2 text-sm font-semibold border-b-2 transition-all ${
            activeTab === "STRUCTURE"
              ? "border-[var(--accent)] text-[var(--accent)]"
              : "border-transparent opacity-60 hover:opacity-100"
          }`}
        >
          ⚙️ طراحی و ویرایش ساختار مسیر برند
        </button>
      </div>

      {activeTab === "ANSWERS" ? (
        <ParticipantAnswersViewer sections={sections} />
      ) : (
        <div className="mt-4">
          {situations.length === 0 && (
            <p className="mb-3 text-xs" style={{ color: "#e0a63f" }}>
              هنوز هیچ موقعیتی تعریف نشده — برای استفاده از «برچسب صفت»، اول از صفحه‌ی
              «موقعیت‌ها و صفات» حداقل یک موقعیت و چند صفت بسازید.
            </p>
          )}

          <SectionsManager sections={sections} onChanged={reload} />

          <div className="mt-6 space-y-4">
            {sections.map((s) => (
              <SectionPanel key={s.id} section={s} situations={situations} />
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
