import { FormattedContent } from "../components/FormattedContent";
import { useEffect, useState } from "react";
import { useParams, Link } from "react-router-dom";
import { BootcampDetail, getBootcamp } from "../api/bootcamps";
import { Task, TaskSubmission, listBootcampTasks, listMySubmissions, submitTask } from "../api/tasks";
import { ResponseWithVersions, listMyResponses } from "../api/responses";
import { getActiveSessionForBootcamp, LiveSession } from "../api/liveSession";
import { QuestionBlock } from "../components/QuestionBlock";
import { Button, Card, LoadError, Spinner, Textarea } from "../components/ui";
import { createBootcampRegistration, myBootcampRegistrations } from "../api/bootcampRegistrations";

function TaskCard({ task }: { task: Task }) {
  const [submissions, setSubmissions] = useState<TaskSubmission[] | null>(null);
  const [draft, setDraft] = useState("");
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    listMySubmissions(task.id).then(setSubmissions);
  }, [task.id]);

  const handleSubmit = async () => {
    if (!draft.trim()) return;
    setSaving(true);
    try {
      await submitTask(task.id, draft);
      setDraft("");
      listMySubmissions(task.id).then(setSubmissions);
    } finally {
      setSaving(false);
    }
  };

  return (
    <Card>
      <p className="font-medium">{task.title}</p>
      {task.description && (
        <FormattedContent content={task.description} className="mt-1 text-sm opacity-70" />
      )}

      {submissions && submissions.length > 0 && (
        <div className="mt-3 space-y-2 border-t pt-3" style={{ borderColor: "var(--surface)" }}>
          {submissions.map((s) => (
            <div key={s.id} className="rounded-lg p-2 text-sm" style={{ backgroundColor: "var(--surface)" }}>
              <div className="text-xs opacity-60">{new Date(s.createdAt).toLocaleDateString("fa-IR")}</div>
              {s.content}
            </div>
          ))}
        </div>
      )}

      <div className="mt-3">
        <Textarea rows={2} placeholder="ارسال جدید..." value={draft} onChange={(e) => setDraft(e.target.value)} />
        <Button className="mt-2" onClick={handleSubmit} disabled={saving || !draft.trim()}>
          {saving ? "در حال ارسال..." : "ارسال"}
        </Button>
      </div>
    </Card>
  );
}

const STATUS_LABEL: Record<string, string> = {
  LOCKED: "قفل‌شده",
  COMING_SOON: "به‌زودی",
  ACTIVE: "فعال",
  DEADLINE_APPROACHING: "مهلت رو به پایان",
  SUBMITTED: "ثبت‌شده",
  COMPLETED: "تکمیل‌شده",
};

const REGISTRATION_STATUS_LABEL: Record<string, string> = {
  INITIAL: "ثبت اولیه (در انتظار بررسی/پرداخت)",
  PAID: "پرداخت شده",
  FINALIZED: "نهایی شده",
  DONE: "تکمیل شده",
};

function relevantStageFor(status: string): "BEFORE" | "AFTER" | null {
  if (status === "LOCKED" || status === "COMING_SOON") return "BEFORE";
  if (status === "SUBMITTED" || status === "COMPLETED") return "AFTER";
  return null;
}

function renderSmartPlayer(url: string) {
  if (!url) return null;

  const ytMatch = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/);
  if (ytMatch && ytMatch[1]) {
    const embedUrl = `https://www.youtube.com/embed/${ytMatch[1]}`;
    return (
      <div className="relative aspect-video w-full overflow-hidden rounded-xl bg-black shadow-lg">
        <iframe
          src={embedUrl}
          title="YouTube video player"
          className="absolute inset-0 h-full w-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowFullScreen
        />
      </div>
    );
  }

  if (url.includes("drive.google.com")) {
    const driveMatch = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
    const driveId = driveMatch ? driveMatch[1] : null;
    const embedUrl = driveId ? `https://drive.google.com/file/d/${driveId}/preview` : url;
    return (
      <div className="relative aspect-video w-full overflow-hidden rounded-xl bg-black shadow-lg">
        <iframe
          src={embedUrl}
          title="Google Drive video player"
          className="absolute inset-0 h-full w-full border-0"
          allow="autoplay"
          allowFullScreen
        />
      </div>
    );
  }

  if (url.match(/\.(mp4|webm|mov)(\?.*)?$/i) || url.startsWith("http")) {
    return (
      <video
        src={url}
        controls
        className="w-full rounded-xl shadow-lg max-h-[500px] object-cover bg-black"
        playsInline
      />
    );
  }

  return (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      className="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm transition-transform active:scale-95 shadow-md"
      style={{ backgroundColor: "var(--accent)", color: "var(--bg)" }}
    >
      مشاهده یا دانلود فایل ضبط‌شده
    </a>
  );
}

export function BootcampDetailPage() {
  const { bootcampId } = useParams<{ bootcampId: string }>();
  const [bootcamp, setBootcamp] = useState<BootcampDetail | null>(null);
  const [tasks, setTasks] = useState<Task[]>([]);
  const [responses, setResponses] = useState<ResponseWithVersions[]>([]);
  const [liveSession, setLiveSession] = useState<LiveSession | null>(null);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);

  // وضعیت ثبت‌نام کاربر
  const [myRegistration, setMyRegistration] = useState<any | null>(null);
  const [showRegForm, setShowRegForm] = useState(false);
  const [regFullName, setRegFullName] = useState("");
  const [regPhone, setRegPhone] = useState("");
  const [regTelegram, setRegTelegram] = useState("");
  const [regInstagram, setRegInstagram] = useState("");
  const [regNote, setRegNote] = useState("");
  const [regSubmitting, setRegSubmitting] = useState(false);
  const [regError, setRegError] = useState<string | null>(null);
  const [regSuccess, setRegSuccess] = useState(false);

  const reload = () => {
    if (!bootcampId) return;
    setLoading(true);
    setLoadError(null);
    Promise.all([
      getBootcamp(bootcampId),
      listBootcampTasks(bootcampId),
      listMyResponses(),
      myBootcampRegistrations().catch(() => ({ registrations: [] })),
    ])
      .then(([bootcampData, tasksData, responsesData, myRegData]) => {
        setBootcamp(bootcampData);
        setTasks(tasksData);
        setResponses(responsesData);

        const found = (myRegData.registrations || []).find((r: any) => r.bootcampId === bootcampId);
        if (found) {
          setMyRegistration(found);
        }
        setLoading(false);
      })
      .catch(() => {
        setLoadError("بارگذاری اطلاعات بوت‌کمپ با خطا مواجه شد.");
        setLoading(false);
      });

    getActiveSessionForBootcamp(bootcampId)
      .then(setLiveSession)
      .catch(() => setLiveSession(null));
  };

  useEffect(() => {
    reload();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [bootcampId]);

  const handleRegisterSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!bootcampId) return;
    if (!regFullName.trim() || !regPhone.trim()) {
      setRegError("نام کامل و شماره تماس الزامی هستند.");
      return;
    }
    setRegSubmitting(true);
    setRegError(null);

    try {
      const res = await createBootcampRegistration({
        bootcampId,
        fullName: regFullName.trim(),
        phone: regPhone.trim(),
        telegramId: regTelegram.trim() || undefined,
        instagram: regInstagram.trim() || undefined,
        note: regNote.trim() || undefined,
      });
      setMyRegistration(res.registration);
      setRegSuccess(true);
      setShowRegForm(false);
    } catch (err: any) {
      setRegError(err?.response?.data?.message || "خطا در ثبت‌نام. لطفاً مجدداً تلاش کنید.");
    } finally {
      setRegSubmitting(false);
    }
  };

  if (loadError) return <LoadError message={loadError} onRetry={reload} />;

  if (loading || !bootcamp) {
    return (
      <div className="flex justify-center py-16">
        <Spinner />
      </div>
    );
  }

  const bootcampForms = (bootcamp as any).forms as
    | Array<{ id: string; title: string; slug: string; description?: string | null; answers: unknown[] }>
    | undefined;
  const visibleForms = (bootcampForms || []).filter(
    (f) => !f.answers || f.answers.length === 0
  );

  const relevantStage = relevantStageFor(bootcamp.status);
  const visibleQuestions = relevantStage
    ? bootcamp.questions.filter((q) => q.stage === relevantStage)
    : [];
  const showTasks = relevantStage === null;

  const renderBootcampForms = visibleForms.length > 0 && (
    <div className="mb-6 space-y-3">
      {visibleForms.map((f) => (
        <div
          key={f.id}
          className="rounded-xl border p-5 shadow-sm"
          style={{ backgroundColor: "var(--surface)", borderColor: "var(--accent)" }}
        >
          <h3 className="mb-1 text-lg font-bold" style={{ color: "var(--accent)" }}>📝 {f.title}</h3>
          {f.description && (
            <FormattedContent content={f.description} className="mb-3 text-sm opacity-80" />
          )}
          <a
            href={`/forms/${f.slug}`}
            className="inline-block rounded-lg px-5 py-2 text-sm font-semibold transition"
            style={{ backgroundColor: "var(--accent)", color: "var(--bg)" }}
          >
            تکمیل فرم
          </a>
        </div>
      ))}
    </div>
  );

  return (
    <div className="mx-auto max-w-2xl pb-16">
      {renderBootcampForms}
      <Link to="/dashboard/bootcamps" className="text-sm opacity-70 hover:opacity-100 transition">
        ← بازگشت به بوت‌کمپ‌ها / آکادمی
      </Link>

      <div className="mt-2 flex items-center justify-between">
        <h1 className="text-2xl font-bold">{bootcamp.title}</h1>
        <span className="rounded-full px-3 py-1 text-xs" style={{ backgroundColor: "var(--surface)", color: "var(--accent)" }}>
          {STATUS_LABEL[bootcamp.status] ?? bootcamp.status}
        </span>
      </div>

      {bootcamp.description && <FormattedContent content={bootcamp.description} className="mt-2 text-sm opacity-80" />}
      <div className="mt-2 text-xs opacity-60">
        {new Date(bootcamp.date).toLocaleDateString("fa-IR")}
        {bootcamp.instructor && ` · مربی: ${bootcamp.instructor}`}
      </div>

      {bootcamp.journeySection && (
        <Link
          to={`/dashboard/journey/${bootcamp.journeySection.id}`}
          className="mt-3 inline-block text-sm"
          style={{ color: "var(--accent)" }}
        >
          مشاهده بخش مرتبط در مسیر برند من ←
        </Link>
      )}

      {/* بخش باکس ثبت‌نام در بوت‌کمپ */}
      <div className="mt-6">
        {myRegistration ? (
          <div className="rounded-xl border p-4" style={{ backgroundColor: "var(--surface)", borderColor: "var(--accent)" }}>
            <div className="flex items-center justify-between">
              <span className="font-semibold text-sm">وضعیت ثبت‌نام شما:</span>
              <span className="text-xs px-2.5 py-1 rounded-md font-bold" style={{ backgroundColor: "var(--bg)", color: "var(--accent)" }}>
                {REGISTRATION_STATUS_LABEL[myRegistration.status] || myRegistration.status}
              </span>
            </div>
            <p className="mt-2 text-xs opacity-75">
              نام ثبت‌شده: <span className="font-medium">{myRegistration.fullName}</span> ({myRegistration.phone})
            </p>
            {regSuccess && (
              <p className="mt-2 text-xs text-emerald-400">
                درخواست شما با موفقیت ثبت شد و در صف بررسی قرار گرفت.
              </p>
            )}
          </div>
        ) : (
          <div className="rounded-xl border p-5" style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)" }}>
            <div className="flex items-center justify-between">
              <div>
                <h3 className="font-bold text-base">ثبت‌نام در این بوت‌کمپ</h3>
                <p className="text-xs opacity-70 mt-1">برای شرکت در جلسات و دسترسی به منابع، ثبت‌نام کنید.</p>
              </div>
              {!showRegForm && (
                <Button onClick={() => setShowRegForm(true)}>
                  فرم ثبت‌نام
                </Button>
              )}
            </div>

            {showRegForm && (
              <form onSubmit={handleRegisterSubmit} className="mt-4 space-y-3 border-t pt-4" style={{ borderColor: "var(--bg)" }}>
                {regError && (
                  <div className="rounded-lg p-2.5 text-xs text-rose-400 bg-rose-950/40 border border-rose-900/50">
                    {regError}
                  </div>
                )}
                <div>
                  <label className="block text-xs mb-1 opacity-80">نام و نام‌خانوادگی *</label>
                  <input
                    type="text"
                    required
                    value={regFullName}
                    onChange={(e) => setRegFullName(e.target.value)}
                    className="w-full rounded-lg px-3 py-2 text-sm border focus:outline-none"
                    style={{ backgroundColor: "var(--bg)", borderColor: "var(--surface)" }}
                    placeholder="مثال: علی احمدی"
                  />
                </div>
                <div>
                  <label className="block text-xs mb-1 opacity-80">شماره تماس (جهت هماهنگی) *</label>
                  <input
                    type="tel"
                    required
                    value={regPhone}
                    onChange={(e) => setRegPhone(e.target.value)}
                    className="w-full rounded-lg px-3 py-2 text-sm border focus:outline-none"
                    style={{ backgroundColor: "var(--bg)", borderColor: "var(--surface)" }}
                    placeholder="09123456789"
                  />
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label className="block text-xs mb-1 opacity-80">آیدی تلگرام</label>
                    <input
                      type="text"
                      value={regTelegram}
                      onChange={(e) => setRegTelegram(e.target.value)}
                      className="w-full rounded-lg px-3 py-2 text-sm border focus:outline-none"
                      style={{ backgroundColor: "var(--bg)", borderColor: "var(--surface)" }}
                      placeholder="@username"
                    />
                  </div>
                  <div>
                    <label className="block text-xs mb-1 opacity-80">آیدی اینستاگرام</label>
                    <input
                      type="text"
                      value={regInstagram}
                      onChange={(e) => setRegInstagram(e.target.value)}
                      className="w-full rounded-lg px-3 py-2 text-sm border focus:outline-none"
                      style={{ backgroundColor: "var(--bg)", borderColor: "var(--surface)" }}
                      placeholder="username"
                    />
                  </div>
                </div>
                <div>
                  <label className="block text-xs mb-1 opacity-80">یادداشت یا توضیحات (اختیاری)</label>
                  <textarea
                    rows={2}
                    value={regNote}
                    onChange={(e) => setRegNote(e.target.value)}
                    className="w-full rounded-lg px-3 py-2 text-sm border focus:outline-none"
                    style={{ backgroundColor: "var(--bg)", borderColor: "var(--surface)" }}
                    placeholder="اگر نکته یا سوالی دارید بنویسید..."
                  />
                </div>
                <div className="flex gap-2 justify-end pt-2">
                  <Button
                    type="button"
                    variant="ghost"
                    onClick={() => setShowRegForm(false)}
                    disabled={regSubmitting}
                  >
                    انصراف
                  </Button>
                  <Button type="submit" disabled={regSubmitting}>
                    {regSubmitting ? "در حال ثبت..." : "تأیید و ارسال ثبت‌نام"}
                  </Button>
                </div>
              </form>
            )}
          </div>
        )}
      </div>

      {/* Recording Player Section for Completed Bootcamps */}
      {bootcamp.status === "COMPLETED" && (
        <div className="mt-6">
          {bootcamp.recordingUrl ? (
            <Card className="border border-opacity-30 border-[var(--accent)]">
              <div className="mb-3 flex items-center justify-between">
                <h3 className="font-bold text-base flex items-center gap-2">
                  <span>🎬</span> ویدیوی ضبط‌شده جلسه
                </h3>
                <a
                  href={bootcamp.recordingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-xs underline opacity-70 hover:opacity-100"
                  style={{ color: "var(--accent)" }}
                >
                  بازکردن لینک در تب جدید ↗
                </a>
              </div>
              <div className="mt-2">
                {renderSmartPlayer(bootcamp.recordingUrl)}
              </div>
            </Card>
          ) : (
            <div className="rounded-xl p-4 text-xs opacity-75 border" style={{ backgroundColor: "var(--surface)", borderColor: "var(--surface)" }}>
              🔒 این بوت‌کمپ به اتمام رسیده است. فایل ضبط‌شده جلسه برای شرکت‌کنندگان مجاز توسط مسئولین به اشتراک گذاشته می‌شود.
            </div>
          )}
        </div>
      )}

      {relevantStage === "BEFORE" && bootcamp.questions.some((q) => q.stage === "BEFORE") && (
        <p className="mt-4 text-xs opacity-60">
          این بوت‌کمپ هنوز شروع نشده — با پاسخ به سؤالات زیر، نقطه‌ی شروع خودت را ثبت کن.
        </p>
      )}
      {relevantStage === "AFTER" && bootcamp.questions.some((q) => q.stage === "AFTER") && (
        <p className="mt-4 text-xs opacity-60">
          این بوت‌کمپ تمام شده — حالا به همین سؤالات دوباره جواب بده تا تحولت ثبت شود.
        </p>
      )}
      {showTasks && (
        <p className="mt-4 text-xs opacity-60">
          این بوت‌کمپ الان فعال است — تکالیف زیر را انجام بده.
        </p>
      )}

      {liveSession && (
        <Card className="mt-4">
          <p className="text-sm font-medium">جلسه‌ی کار گروهی زنده در حال برگزاری است</p>
          <p className="mt-1 text-xs opacity-70">
            وارد شو تا حضورت ثبت شود؛ به‌محض تقسیم‌بندی گروه‌ها توسط مسئول بوت‌کمپ، صفحه‌ات
            خودکار به گروهت تغییر می‌کند.
          </p>
          <Link to={`/dashboard/bootcamps/live/${liveSession.id}`}>
            <Button className="mt-2">ورود به جلسه‌ی زنده</Button>
          </Link>
        </Card>
      )}

      {visibleQuestions.length > 0 && (
        <div className="mt-4 space-y-3">
          {visibleQuestions.map((q) => (
            <QuestionBlock
              key={q.id}
              question={q}
              existingResponse={responses.find((r) => r.questionId === q.id)}
              onSaved={reload}
            />
          ))}
        </div>
      )}

      {showTasks && tasks.length > 0 && (
        <div className="mt-4 space-y-3">
          {tasks.map((t) => (
            <TaskCard key={t.id} task={t} />
          ))}
        </div>
      )}

      {visibleQuestions.length === 0 && !(showTasks && tasks.length > 0) && (
        <p className="mt-8 text-sm opacity-60">
          {showTasks
            ? "هنوز تکلیفی برای این بوت‌کمپ تعریف نشده است."
            : "هنوز سؤالی متناسب با وضعیت فعلی این بوت‌کمپ تعریف نشده است."}
        </p>
      )}
    </div>
  );
}
