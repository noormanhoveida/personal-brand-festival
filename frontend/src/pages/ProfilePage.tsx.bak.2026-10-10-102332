import { useEffect, useState } from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { AxiosError } from "axios";
import {
  OnboardingInput,
  ParticipantProfile,
  completeOnboarding,
  getProfile,
  getRegions,
  updateProfile,
  RegionItem,
} from "../api/profile";
import { normalizeDigits } from "../utils/digits";
import { PhotoUploader } from "../components/PhotoUploader";
import { SkillsManager } from "../components/SkillsManager";
import { LiveMessagesArchive } from "../components/LiveMessagesArchive";
import { MyLeaderboards } from "../components/MyLeaderboards";
import { Button, Card, ErrorText, Input, Label, Spinner, Textarea } from "../components/ui";

const schema = z.object({
  firstName: z.string().min(1, "نام الزامی است."),
  lastName: z.string().min(1, "نام خانوادگی الزامی است."),
  province: z.string().min(1, "استان الزامی است."),
  city: z.string().min(1, "شهر الزامی است."),
  educationLevel: z.string().optional(),
  fieldOfStudy: z.string().optional(),
  professionalField: z.string().optional(),
  occupation: z.string().optional(),
  bio: z.string().max(1000).optional(),
});

type FormValues = z.infer<typeof schema>;

export function ProfilePage() {
  const [profile, setProfile] = useState<ParticipantProfile | null>(null);
  const [onboardingComplete, setOnboardingComplete] = useState<boolean | null>(null);
  const [mobileText, setMobileText] = useState("");
  const [mobileError, setMobileError] = useState<string | null>(null);
  const [interestsText, setInterestsText] = useState("");
  const [serverError, setServerError] = useState<string | null>(null);
  const [saved, setSaved] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<FormValues>({ resolver: zodResolver(schema) });

  useEffect(() => {
    getProfile().then((res) => {
      setProfile(res.profile);
      setOnboardingComplete(res.onboardingComplete);
      if (res.profile) {
        reset({
          firstName: res.profile.firstName,
          lastName: res.profile.lastName,
          province: res.profile.province,
          city: res.profile.city,
          educationLevel: res.profile.educationLevel ?? "",
          fieldOfStudy: res.profile.fieldOfStudy ?? "",
          professionalField: res.profile.professionalField ?? "",
          occupation: res.profile.occupation ?? "",
          bio: res.profile.bio ?? "",
        });
        setMobileText(res.profile.mobile);
        setInterestsText((res.profile.interests ?? []).join("، "));
      }
    });
  }, [reset]);

  const onSubmit = async (values: FormValues) => {
    setServerError(null);
    setMobileError(null);
    setSaved(false);

    // Mobile is validated here, not through the RHF/zod resolver — the
    // digit normalization happens live on every keystroke below, so by
    // the time the user submits, mobileText is already ASCII (Persian
    // and Arabic-Indic digits are converted as they're typed).
    const normalizedMobile = normalizeDigits(mobileText.trim());
    if (!/^09\d{9}$/.test(normalizedMobile)) {
      setMobileError("فرمت شماره موبایل باید ۰۹xxxxxxxxx باشد.");
      return;
    }

    try {
      const interests = interestsText
        .split(/[،,]/)
        .map((s) => s.trim())
        .filter(Boolean);
      const input: OnboardingInput = { ...values, mobile: normalizedMobile, interests };
      const result = onboardingComplete ? await updateProfile(input) : await completeOnboarding(input);
      setProfile(result);
      setOnboardingComplete(true);
      setSaved(true);
    } catch (err) {
      const message =
        (err as AxiosError<{ message?: string }>).response?.data?.message ??
        "ثبت اطلاعات با خطا مواجه شد.";
      setServerError(message);
    }
  };

  if (onboardingComplete === null) {
    return (
      <div className="flex justify-center py-16">
        <Spinner />
      </div>
    );
  }

  return (
    <div className="mx-auto max-w-2xl">
      <h1 className="text-2xl font-bold">{onboardingComplete ? "پروفایل من" : "تکمیل پروفایل"}</h1>
      <p className="mt-1 text-sm opacity-70">
        {onboardingComplete
          ? "اطلاعات پروفایل خود را ویرایش کنید."
          : "قبل از شروع مسیر برند شخصی، لطفاً این فرم را تکمیل کنید."}
      </p>

      <Card className="mt-6">
        <form onSubmit={handleSubmit(onSubmit)} className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <Label>نام</Label>
            <Input {...register("firstName")} />
            <ErrorText>{errors.firstName?.message}</ErrorText>
          </div>
          <div>
            <Label>نام خانوادگی</Label>
            <Input {...register("lastName")} />
            <ErrorText>{errors.lastName?.message}</ErrorText>
          </div>
          <div>
            <Label>شماره موبایل</Label>
            <Input
              value={mobileText}
              onChange={(e) => setMobileText(normalizeDigits(e.target.value))}
              placeholder="09xxxxxxxxx"
              inputMode="numeric"
            />
            <ErrorText>{mobileError}</ErrorText>
          </div>
          <div>
            <Label>استان</Label>
            <Input {...register("province")} />
            <ErrorText>{errors.province?.message}</ErrorText>
          </div>
          <div>
            <Label>شهر</Label>
            <Input {...register("city")} />
            <ErrorText>{errors.city?.message}</ErrorText>
          </div>
          <div>
            <Label>سطح تحصیلات</Label>
            <Input {...register("educationLevel")} />
          </div>
          <div>
            <Label>رشته تحصیلی</Label>
            <Input {...register("fieldOfStudy")} />
          </div>
          <div>
            <Label>حوزه حرفه‌ای</Label>
            <Input {...register("professionalField")} />
          </div>
          <div>
            <Label>شغل فعلی</Label>
            <Input {...register("occupation")} />
          </div>
          <div className="sm:col-span-2">
            <Label>بیوگرافی کوتاه</Label>
            <Textarea rows={4} {...register("bio")} />
          </div>
          <div className="sm:col-span-2">
            <Label>علایق حرفه‌ای (با ، از هم جدا کنید)</Label>
            <Input value={interestsText} onChange={(e) => setInterestsText(e.target.value)} />
          </div>

          <div className="sm:col-span-2 flex items-center gap-3">
            <Button type="submit" disabled={isSubmitting}>
              {isSubmitting ? "در حال ذخیره..." : "ذخیره"}
            </Button>
            {saved && <span className="text-xs" style={{ color: "var(--accent)" }}>ذخیره شد ✓</span>}
          </div>
          <ErrorText>{serverError}</ErrorText>
        </form>
      </Card>

      {onboardingComplete && (
        <Card className="mt-6">
          <h2 className="mb-3 text-sm font-semibold">تصاویر پروفایل</h2>
          <PhotoUploader firstName={profile?.firstName} lastName={profile?.lastName} />
        </Card>
      )}

      {onboardingComplete && (
        <div className="mt-6">
          <SkillsManager />
        </div>
      )}

      {onboardingComplete && <LiveMessagesArchive />}
      {onboardingComplete && <MyLeaderboards />}
    </div>
  );
}
