import { NavLink, Outlet, useLocation, Link } from "react-router-dom";
import { motion, AnimatePresence } from "framer-motion";
import { ThemeSwitcher } from "../features/theme/ThemeSwitcher";
import { useAppSelector } from "../hooks/redux";
import { PreAssessmentGate } from "../components/PreAssessmentGate";
import { announcementsApi } from "../api/announcements";
import { ticketsApi } from "../api/tickets";

const PARTICIPANT_NAV = [
  { to: "/dashboard", label: "داشبورد" },
  { to: "/dashboard/journey", label: "مسیر برند من" },
  { to: "/dashboard/bootcamps", label: "بوت‌کمپ‌ها / آکادمی" },
  { to: "/dashboard/challenges", label: "چالش‌های هفتگی" },
  { to: "/dashboard/mirror", label: "آینه من" },
  { to: "/dashboard/artifacts", label: "آثار و دستاوردها" },
  { to: "/dashboard/transformation", label: "مسیر تحول" },
  { to: "/dashboard/profile", label: "پروفایل من" },
  { to: "/dashboard/public-page", label: "صفحه عمومی من" },
  { to: "/dashboard/tickets", label: "چت و پشتیبانی" },
  { to: "/dashboard/announcements", label: "اطلاعیه‌ها" },
];

const EVALUATOR_NAV = [
  { to: "/dashboard/evaluator", label: "شرکت‌کنندگان من" },
  { to: "/dashboard/approval", label: "تأیید پاسخ‌ها" },
  { to: "/dashboard/leaderboards", label: "تابلوهای امتیاز" },
  { to: "/dashboard/tickets", label: "چت و پشتیبانی" },
  { to: "/dashboard/announcements", label: "اطلاعیه‌ها" },
];

const MANAGER_NAV = [
  { to: "/dashboard/manager/bootcamps", label: "مدیریت بوت‌کمپ‌ها / آکادمی" },
  { to: "/dashboard/manager/challenges", label: "چالش‌های هفتگی" },
  { to: "/dashboard/tickets", label: "چت و پشتیبانی" },
  { to: "/dashboard/announcements", label: "اطلاعیه‌ها" },
];

const ADMIN_NAV = [
  { to: "/dashboard/admin", label: "نمای کلی" },
  { to: "/dashboard/admin/hub-site", label: "مدیریت سایت" },
  { to: "/dashboard/admin/hub-eval", label: "مدیریت ارزیابی" },
  { to: "/dashboard/admin/hub-academy", label: "مدیریت آکادمی و بوت‌کمپ" },
  { to: "/dashboard/admin/hub-science", label: "مدیریت علمی" },
];

function NavSection({
  title,
  items,
  onNavigate,
}: {
  title?: string;
  items: { to: string; label: string }[];
  onNavigate?: () => void;
}) {
  return (
    <div className="mb-4">
      {title && (
        <div className="mb-1 px-3 text-xs font-semibold uppercase tracking-wider opacity-50">
          {title}
        </div>
      )}
      <div className="space-y-0.5">
        {items.map((it) => (
          <NavLink
            key={it.to}
            to={it.to}
            end={it.to === "/dashboard"}
            onClick={onNavigate}
            className={({ isActive }) =>
              `flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium transition ${
                isActive
                  ? "bg-amber-500/15 text-amber-500 font-bold"
                  : "opacity-75 hover:opacity-100 hover:bg-white/5"
              }`
            }
          >
            <span>{it.label}</span>
          </NavLink>
        ))}
      </div>
    </div>
  );
}

function BellButton({ count }: { count: number }) {
  return (
    <Link
      to="/dashboard/announcements"
      title="اطلاعیه‌ها"
      className="relative inline-flex items-center justify-center rounded-full border p-2 transition hover:scale-105"
      style={{ borderColor: "var(--surface)", backgroundColor: "var(--bg-secondary)" }}
    >
      <svg
        className="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        strokeWidth="1.8"
      >
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          d="M14.857 17H9.143m9.714 0A2.143 2.143 0 0017.714 15V11a5.714 5.714 0 10-11.428 0v4A2.143 2.143 0 005.143 17m13.714 0H5.143m5.214 0a1.643 1.643 0 003.286 0"
        />
      </svg>
      {count > 0 && (
        <span className="absolute -right-1 -top-1 min-w-[18px] rounded-full bg-red-500 px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-white">
          {count > 99 ? "99+" : count}
        </span>
      )}
    </Link>
  );
}



function NavContent({ role, onNavigate }: { role?: any; onNavigate?: () => void }) {
  return (
    <>
      <div className="mb-4 px-3 text-base font-extrabold tracking-tight" style={{ color: "var(--accent)" }}>
        فستیوال برند شخصی
      </div>

      <NavSection items={PARTICIPANT_NAV} onNavigate={onNavigate} />

      {role === "EVALUATOR" && (
        <NavSection title="پنل ارزیاب" items={EVALUATOR_NAV} onNavigate={onNavigate} />
      )}
      {(role === "BOOTCAMP_MANAGER" || role === "ADMIN") && (
        <NavSection title="مدیریت بوت‌کمپ‌ها / آکادمی" items={MANAGER_NAV} onNavigate={onNavigate} />
      )}
      {role === "ADMIN" && <NavSection title="مدیریت" items={ADMIN_NAV} onNavigate={onNavigate} />}
      <div className="mt-auto">
        <NavSection items={[{ to: "/dashboard/settings", label: "تنظیمات" }]} onNavigate={onNavigate} />
      </div>
    </>
  );
}

export function DashboardLayout() {
  const role = useAppSelector((s) => s.auth.role);
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [announcementCount, setAnnouncementCount] = useState(0);
  const [hasOpenTicket, setHasOpenTicket] = useState(false);
  const location = useLocation();

  const isDashboardHome = location.pathname === "/dashboard" || location.pathname === "/dashboard/";
  const isTicketsPage = location.pathname.startsWith("/dashboard/tickets");

  useEffect(() => {
    let alive = true;

    announcementsApi
      .getAnnouncements()
      .then((items) => {
        if (!alive) return;
        setAnnouncementCount(Array.isArray(items) ? items.length : 0);
      })
      .catch(() => {
        if (!alive) return;
        setAnnouncementCount(0);
      });

    const ticketRequest =
      role === "ADMIN" ? ticketsApi.getAllTickets() : ticketsApi.getMyTickets();

    ticketRequest
      .then((items) => {
        if (!alive) return;
        const list = Array.isArray(items) ? items : [];
        setHasOpenTicket(list.some((t) => t.status === "OPEN" || t.status === "ANSWERED"));
      })
      .catch(() => {
        if (!alive) return;
        setHasOpenTicket(false);
      });

    return () => {
      alive = false;
    };
  }, [role]);


  return (
    <div className="flex min-h-screen relative">
      <PreAssessmentGate />

      {/* Desktop sidebar */}
      <aside
        className="hidden w-64 shrink-0 flex-col gap-1 border-l px-4 py-6 md:flex"
        style={{ backgroundColor: "var(--bg-secondary)", borderColor: "var(--surface)" }}
      >
        <NavContent role={role} />
      </aside>

      {/* Mobile drawer */}
      <AnimatePresence>
        {drawerOpen && (
          <>
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setDrawerOpen(false)}
              className="fixed inset-0 z-[90] bg-black/50 md:hidden"
            />
            <motion.aside
              initial={{ x: "100%" }}
              animate={{ x: 0 }}
              exit={{ x: "100%" }}
              transition={{ type: "tween", duration: 0.25 }}
              className="fixed inset-y-0 right-0 z-[100] flex w-[85vw] max-w-[320px] shadow-2xl flex-col gap-1 overflow-y-auto px-4 py-6 md:hidden"
              style={{ backgroundColor: "var(--bg-secondary)" }}
            >
              <button
                onClick={() => setDrawerOpen(false)}
                className="mb-4 self-start text-sm opacity-70"
              >
                ✕ بستن
              </button>
              <NavContent role={role} onNavigate={() => setDrawerOpen(false)} />
            </motion.aside>
          </>
        )}
      </AnimatePresence>

      <div className="flex flex-1 flex-col">
        <header
          className="flex items-center justify-between gap-3 border-b px-6 py-3"
          style={{ borderColor: "var(--surface)" }}
        >
          <div className="flex items-center gap-2">
            <button
              onClick={() => setDrawerOpen(true)}
              className="text-sm opacity-70 md:hidden"
              aria-label="باز کردن منو"
            >
              ☰ منو
            </button>
            <BellButton count={announcementCount} />
          </div>

          <nav
            aria-label="پیوندهای عمومی"
            className="hidden min-w-0 flex-1 md:flex items-center justify-center gap-3 overflow-x-auto px-2 text-xs md:gap-6 md:text-sm"
          >
            <Link to="/" className="whitespace-nowrap opacity-80 transition hover:opacity-100">
              صفحه اصلی
            </Link>
            <Link to="/community" className="whitespace-nowrap opacity-80 transition hover:opacity-100">
              شرکت‌کنندگان
            </Link>
            <Link to="/showcase" className="whitespace-nowrap opacity-80 transition hover:opacity-100">
              برترین‌های جشنواره
            </Link>
            <Link to="/dashboard/bootcamps" className="whitespace-nowrap opacity-80 transition hover:opacity-100">
              بوت‌کمپ‌ها / آکادمی
            </Link>
          </nav>

          <ThemeSwitcher />
        </header>

        <main className="flex-1 p-6">
          <Outlet />
        </main>
      </div>

      

      <AnimatePresence>
      </AnimatePresence>

      {hasOpenTicket && !isTicketsPage && (
        <div className="fixed bottom-24 right-7 z-30 hidden md:block">
          <div className="rounded-full bg-emerald-500 px-3 py-1 text-[11px] font-bold text-white shadow-lg">
            گفت‌وگوی فعال
          </div>
        </div>
      )}
    </div>
  );
}
