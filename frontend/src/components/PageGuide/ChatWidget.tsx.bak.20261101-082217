import React, { useState, useEffect, useRef } from "react";
import { motion } from "framer-motion";
import { apiClient } from "../../api/client";

interface UserItem {
  id: string;
  name: string;
  avatarUrl?: string | null;
  role: string;
}

interface MessageItem {
  id: string;
  senderId: string;
  receiverId: string;
  content: string;
  createdAt: string;
}

function ChatAvatar({ name, url }: { name: string; url?: string | null }) {
  return (
    <div className="relative flex h-8 w-8 flex-shrink-0 items-center justify-center overflow-hidden rounded-full border border-zinc-700 bg-zinc-800 text-xs font-bold text-amber-400">
      <span>{name?.trim().charAt(0) || "؟"}</span>
      {url && (
        <img
          src={url}
          alt=""
          className="absolute inset-0 h-full w-full object-cover"
          onError={(event) => { event.currentTarget.style.display = "none"; }}
        />
      )}
    </div>
  );
}

export default function ChatWidget({ onClose }: { onClose: () => void }) {
  const [selectedUser, setSelectedUser] = useState<UserItem | null>(null);
  const [users, setUsers] = useState<UserItem[]>([]);
  const [conversations, setConversations] = useState<any[]>([]);
  const [messages, setMessages] = useState<MessageItem[]>([]);
  const [inputText, setInputText] = useState("");
  const [search, setSearch] = useState("");
  const [currentUserId, setCurrentUserId] = useState<string | null>(null);
  const [ownAvatarUrl, setOwnAvatarUrl] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [activeTab, setActiveTab] = useState<"chats" | "users">("users");
  const messagesEndRef = useRef<HTMLDivElement>(null);

  // واکشی پروفایل فعلی
  useEffect(() => {
    apiClient.get("/auth/me")
      .then((res: any) => {
        const uId = res.data?.data?.user?.id || res.data?.data?.id || res.data?.user?.id;
        setCurrentUserId(uId);
        setOwnAvatarUrl(
          res.data?.data?.user?.avatarUrl ??
          res.data?.data?.avatarUrl ??
          res.data?.user?.avatarUrl ??
          null
        );
      })
      .catch((e: any) => console.error("Auth check failed:", e));
  }, []);

  // واکشی مکالمات
  const loadConversations = async () => {
    try {
      const res: any = await apiClient.get("/chat/conversations");
      const list = res.data?.data || res.data || [];
      if (Array.isArray(list)) {
        setConversations(list);
      }
    } catch (e) {
      console.error("Error loading conversations:", e);
    }
  };

  // واکشی لیست کاربران
  const searchUsers = async (query = "") => {
    try {
      setIsLoading(true);
      const res: any = await apiClient.get(`/chat/users?search=${encodeURIComponent(query)}`);
      const list = res.data?.data || res.data || [];
      if (Array.isArray(list)) {
        setUsers(list);
      }
    } catch (e) {
      console.error("Error loading users:", e);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    loadConversations();
    searchUsers("");
  }, []);

  // واکشی پیام‌های کاربر انتخاب‌شده + پولینگ
  useEffect(() => {
    if (!selectedUser) return;

    const fetchMsgs = async () => {
      try {
        const res: any = await apiClient.get(`/chat/messages/${selectedUser.id}`);
        const list = res.data?.data || res.data || [];
        if (Array.isArray(list)) {
          setMessages(list);
          // دریافت پیام‌ها در بک‌اند آنها را خوانده‌شده می‌کند.
          window.dispatchEvent(new Event("chat:read"));
        }
      } catch (e) {
        console.error("Error loading messages:", e);
      }
    };

    fetchMsgs();
    const interval = setInterval(fetchMsgs, 3000);
    return () => clearInterval(interval);
  }, [selectedUser]);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  // ارسال پیام
  const handleSend = async (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    if (!inputText.trim() || !selectedUser) return;

    const textToSend = inputText.trim();
    setInputText("");

    try {
      const res: any = await apiClient.post("/chat/send", {
        receiverId: selectedUser.id,
        content: textToSend,
      });

      const newMsg = res.data?.data || res.data;
      if (newMsg && newMsg.id) {
        setMessages((prev) => [...prev, newMsg]);
        loadConversations();
      }
    } catch (err: any) {
      alert(err.response?.data?.message || "خطا در ارسال پیام");
    }
  };

  return (
    <motion.div
      initial={{ opacity: 0, y: 20, scale: 0.95 }}
      animate={{ opacity: 1, y: 0, scale: 1 }}
      exit={{ opacity: 0, y: 20, scale: 0.95 }}
      className="fixed bottom-20 left-6 z-[9998] w-88 max-w-[95vw] h-[520px] flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950 shadow-2xl overflow-hidden font-sans text-right"
      dir="rtl"
    >
      {/* هدر */}
      <div className="p-3.5 border-b border-zinc-800 flex justify-between items-center bg-zinc-900/90 backdrop-blur-md">
        <div className="flex items-center gap-2">
          {selectedUser ? (
            <button
              onClick={() => { setSelectedUser(null); loadConversations(); }}
              className="text-zinc-400 hover:text-white text-xs flex items-center gap-1 bg-zinc-800 px-2 py-1 rounded-lg"
            >
              ← بازگشت
            </button>
          ) : (
            <div className="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" />
          )}
          <span className="text-sm font-bold text-amber-400 truncate max-w-[180px]">
            {selectedUser ? selectedUser.name : "پیام‌رسان کاربران"}
          </span>
        </div>
        <button onClick={onClose} className="text-zinc-400 hover:text-white p-1 rounded-md text-base">✕</button>
      </div>

      {!selectedUser ? (
        <div className="flex flex-col flex-1 overflow-hidden">
          {/* تب‌ها */}
          <div className="flex border-b border-zinc-800 bg-zinc-900/40 text-xs">
            <button
              onClick={() => setActiveTab("users")}
              className={`flex-1 py-2.5 text-center font-medium transition ${activeTab === "users" ? "border-b-2 border-amber-500 text-amber-400 bg-zinc-800/40" : "text-zinc-400 hover:text-zinc-200"}`}
            >
              کاربران سایت ({users.length})
            </button>
            <button
              onClick={() => setActiveTab("chats")}
              className={`flex-1 py-2.5 text-center font-medium transition ${activeTab === "chats" ? "border-b-2 border-amber-500 text-amber-400 bg-zinc-800/40" : "text-zinc-400 hover:text-zinc-200"}`}
            >
              گفت‌وگوها ({conversations.length})
            </button>
          </div>

          {/* نوار جستجو برای تب کاربران */}
          {activeTab === "users" && (
            <div className="p-2 border-b border-zinc-800/80 bg-zinc-900/20">
              <input
                type="text"
                placeholder="جستجوی نام یا ایمیل کاربر..."
                value={search}
                onChange={(e) => {
                  setSearch(e.target.value);
                  searchUsers(e.target.value);
                }}
                className="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-1.5 text-xs text-white placeholder-zinc-500 outline-none focus:border-amber-500/60"
              />
            </div>
          )}

          {/* محتوا */}
          <div className="flex-1 overflow-y-auto divide-y divide-zinc-900/60 p-2 space-y-1">
            {activeTab === "users" ? (
              users.length === 0 ? (
                <div className="text-center py-12 text-zinc-500 text-xs">
                  {isLoading ? "در حال دریافت کاربران..." : "کاربری یافت نشد."}
                </div>
              ) : (
                users.map((u) => (
                  <div
                    key={u.id}
                    onClick={() => { setMessages([]); setSelectedUser(u); }}
                    className="flex items-center justify-between p-2.5 rounded-xl hover:bg-zinc-900 cursor-pointer transition"
                  >
                    <div className="flex items-center gap-2.5 min-w-0">
                      <div className="w-8 h-8 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center font-bold text-amber-400 text-xs overflow-hidden flex-shrink-0">
                        {u.name ? u.name.charAt(0) : "?"}
                      </div>
                      <span className="text-xs font-medium text-zinc-200 truncate">{u.name || "کاربر سایت"}</span>
                    </div>
                    <span className="text-[10px] bg-zinc-800 hover:bg-amber-500 hover:text-zinc-950 text-zinc-400 px-2 py-0.5 rounded-md transition">شروع گفت‌وگو</span>
                  </div>
                ))
              )
            ) : (
              conversations.length === 0 ? (
                <div className="text-center py-12 text-zinc-500 text-xs">
                  هیچ مکالمه‌ای ندارید.
                  <br />
                  از تب «کاربران سایت» یک نفر را انتخاب کنید.
                </div>
              ) : (
                conversations.map((c) => (
                  <div
                    key={c.userId}
                    onClick={() => { setMessages([]); setSelectedUser({ id: c.userId, name: c.name, avatarUrl: c.avatarUrl, role: "USER" }); }}
                    className="flex items-center gap-3 p-2.5 rounded-xl hover:bg-zinc-900 cursor-pointer transition"
                  >
                    <div className="w-9 h-9 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center font-bold text-amber-400 text-xs overflow-hidden flex-shrink-0">
                      {c.name.charAt(0)}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex justify-between items-baseline mb-0.5">
                        <span className="text-xs font-semibold text-zinc-200 truncate">{c.name}</span>
                        {c.unreadCount > 0 && (
                          <span className="bg-amber-500 text-zinc-950 font-black rounded-full px-1.5 py-0.2 text-[10px]">
                            {c.unreadCount}
                          </span>
                        )}
                      </div>
                      <p className="text-[11px] text-zinc-500 truncate">{c.lastMessage}</p>
                    </div>
                  </div>
                ))
              )
            )}
          </div>
        </div>
      ) : (
        /* صفحه چت */
        <div className="flex flex-col flex-1 overflow-hidden bg-zinc-950/60">
          <div className="flex-1 p-3 overflow-y-auto space-y-2.5">
            {messages.length === 0 ? (
              <div className="text-center py-12 text-zinc-600 text-xs">
                اولین پیام را به {selectedUser.name} ارسال کنید!
              </div>
            ) : (
              messages.map((m) => {
                const isMe = m.senderId === currentUserId;
                return (
                  <div
                    key={m.id}
                    dir="rtl"
                    className={`flex items-end gap-2 ${isMe ? "flex-row" : "flex-row-reverse"}`}
                  >
                    <ChatAvatar
                      name={isMe ? "شما" : selectedUser.name}
                      url={isMe ? ownAvatarUrl : selectedUser.avatarUrl}
                    />
                    <div className={`flex min-w-0 max-w-[75%] flex-col ${isMe ? "items-start" : "items-end"}`}>
                      <span className="mb-1 px-1 text-[10px] text-zinc-400">
                        {isMe ? "شما" : selectedUser.name}
                      </span>
                      <div
                        dir="auto"
                        className={`max-w-full break-words rounded-2xl px-3 py-2 text-xs leading-relaxed shadow-sm ${
                          isMe
                            ? "rounded-br-none bg-amber-500 font-medium text-zinc-950"
                            : "rounded-bl-none border border-zinc-700/80 bg-zinc-800 text-zinc-200"
                        }`}
                      >
                        {m.content}
                      </div>
                      <span className="mt-1 px-1 text-[9px] text-zinc-500">
                        {new Date(m.createdAt).toLocaleTimeString("fa-IR", { hour: "2-digit", minute: "2-digit" })}
                      </span>
                    </div>
                  </div>
                );
              })
            )}
            <div ref={messagesEndRef} />
          </div>

          <form onSubmit={handleSend} className="p-2.5 border-t border-zinc-800/80 bg-zinc-900/60 flex items-center gap-2">
            <input
              type="text"
              placeholder="پیام خود را بنویسید..."
              value={inputText}
              onChange={(e) => setInputText(e.target.value)}
              className="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white placeholder-zinc-500 outline-none focus:border-amber-500"
            />
            <button
              type="submit"
              disabled={!inputText.trim()}
              className="bg-amber-500 hover:bg-amber-400 disabled:opacity-40 text-zinc-950 font-bold px-3 py-2 rounded-xl text-xs transition flex items-center justify-center gap-1 shadow-md"
            >
              ارسال
            </button>
          </form>
        </div>
      )}
    </motion.div>
  );
}
