import { apiClient } from "./client";

export interface BusinessVideo {
  id: string;
  businessName: string;
  ownerName: string;
  category: string;
  videoUrl: string;
  thumbnailUrl: string | null;
  durationSeconds: number;
  description: string | null;
  websiteUrl: string | null;
  instagramUrl: string | null;
  telegramUrl: string | null;
  phoneNumber: string | null;
  status: string;
  viewCount: number;
  likeCount: number;
  isFeatured: boolean;
  createdAt: string;
  _count?: { comments: number; likes: number };
}

export interface BusinessVideoList {
  items: BusinessVideo[];
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
}

export interface BusinessVideoFilters {
  category?: string;
  page?: number;
  limit?: number;
}

export async function getPublicBusinessVideos(
  filters: BusinessVideoFilters = {},
): Promise<BusinessVideoList> {
  const { data } = await apiClient.get<BusinessVideoList>(
    "/business-showcase/public",
    { params: filters },
  );
  return data;
}

export async function getPublicBusinessVideo(id: string): Promise<BusinessVideo> {
  const { data } = await apiClient.get<BusinessVideo>(
    `/business-showcase/${encodeURIComponent(id)}`,
  );
  return data;
}

export type BusinessCategory =
  | "TECH"
  | "SERVICES"
  | "EDUCATION"
  | "RETAIL"
  | "CREATIVE"
  | "OTHER";

export interface BusinessVideoUploadResult {
  message: string;
  videoUrl: string;
  fileSizeBytes: number;
}

export interface CreateBusinessVideoInput {
  businessName: string;
  ownerName: string;
  category: BusinessCategory;
  videoUrl: string;
  durationSeconds: number;
  fileSizeBytes: number;
  description?: string | null;
  websiteUrl?: string | null;
  instagramUrl?: string | null;
  telegramUrl?: string | null;
  phoneNumber?: string | null;
}

export async function uploadBusinessVideo(
  file: File,
): Promise<BusinessVideoUploadResult> {
  const formData = new FormData();
  formData.append("video", file);
  const { data } = await apiClient.post<BusinessVideoUploadResult>(
    "/business-showcase/upload",
    formData,
  );
  return data;
}

export async function createBusinessVideo(
  input: CreateBusinessVideoInput,
): Promise<{ message: string; video: BusinessVideo }> {
  const { data } = await apiClient.post<{
    message: string;
    video: BusinessVideo;
  }>("/business-showcase", input);
  return data;
}
export async function getMyBusinessVideos(): Promise<BusinessVideo[]> {
  const { data } = await apiClient.get<BusinessVideo[]>("/business-showcase/user/my-videos");
  return data;
}

export async function deleteBusinessVideo(id: string): Promise<{ message: string }> {
  const { data } = await apiClient.delete<{ message: string }>(`/business-showcase/${encodeURIComponent(id)}`);
  return data;
}
