# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brand_festival?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5555/mydb"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Cookies
REFRESH_COOKIE_NAME="brand_festival_rt"

# Storage (local dev default; swap for S3-compatible config in production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3-compatible (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
