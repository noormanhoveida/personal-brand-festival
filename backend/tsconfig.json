{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": "src",
    "typeRoots": ["./node_modules/@types", "./src/types"],
 "rootDir": "src",
    "outDir": "dist"
  },
   "include": ["src"],
  "exclude": ["node_modules", "dist", "tests", "prisma"]
}
