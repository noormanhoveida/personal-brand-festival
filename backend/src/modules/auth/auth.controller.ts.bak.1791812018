import { Request, Response, NextFunction } from "express";
import { env } from "../../config/env";
import {
  loginUser,
  registerUser,
  registerPhoneUser,
  resendVerificationCode,
  resendPhoneVerificationCode,
  revokeRefreshToken,
  rotateRefreshToken,
  verifyEmail,
  verifyPhone,
} from "./auth.service";

const REFRESH_COOKIE_OPTIONS = {
  httpOnly: true,
  secure: env.nodeEnv === "production",
  sameSite: "lax" as const,
  path: "/",
  maxAge: env.jwtRefreshExpiresInDays * 24 * 60 * 60 * 1000,
};

function setRefreshCookie(res: Response, refreshToken: string) {
  res.cookie(env.refreshCookieName, refreshToken, REFRESH_COOKIE_OPTIONS);
}

export async function register(req: Request, res: Response, next: NextFunction) {
  try {
    const { email, phone, password } = req.body;
    if (phone) {
      const result = await registerPhoneUser(phone, password);
      return res.status(201).json({
        message: "کد تأیید به شماره شما پیامک شد.",
        phone: result.phone,
        channel: "phone",
      });
    }
    const result = await registerUser(email, password);
    return res.status(201).json({
      message: "کد تأیید به ایمیل شما ارسال شد.",
      email: result.email,
      channel: "email",
    });
  } catch (err) {
    next(err);
  }
}

export async function login(req: Request, res: Response, next: NextFunction) {
  try {
    const { identifier, password } = req.body;
    const { accessToken, refreshToken, role } = await loginUser(identifier, password);
    setRefreshCookie(res, refreshToken);
    res.status(200).json({ accessToken, role });
  } catch (err) {
    next(err);
  }
}

export async function refresh(req: Request, res: Response, next: NextFunction) {
  try {
    const presented = req.cookies?.[env.refreshCookieName];
    if (!presented) {
      return res.status(401).json({ message: "توکن رفرش یافت نشد." });
    }
    const { accessToken, refreshToken, role } = await rotateRefreshToken(presented);
    setRefreshCookie(res, refreshToken);
    res.status(200).json({ accessToken, role });
  } catch (err) {
    next(err);
  }
}

export async function logout(req: Request, res: Response, next: NextFunction) {
  try {
    const presented = req.cookies?.[env.refreshCookieName];
    if (presented) {
      await revokeRefreshToken(presented);
    }
    res.clearCookie(env.refreshCookieName, { path: "/auth" });
    res.status(204).send();
  } catch (err) {
    next(err);
  }
}

export async function verifyEmailCode(req: Request, res: Response, next: NextFunction) {
  try {
    const { email, code } = req.body;
    const { accessToken, refreshToken, role } = await verifyEmail(email, code);
    setRefreshCookie(res, refreshToken);
    res.status(200).json({ accessToken, role });
  } catch (err) {
    next(err);
  }
}

export async function verifyPhoneCode(req: Request, res: Response, next: NextFunction) {
  try {
    const { phone, code } = req.body;
    const { accessToken, refreshToken, role } = await verifyPhone(phone, code);
    setRefreshCookie(res, refreshToken);
    res.status(200).json({ accessToken, role });
  } catch (err) {
    next(err);
  }
}

export async function resendVerification(req: Request, res: Response, next: NextFunction) {
  try {
    await resendVerificationCode(req.body.email);
    res.status(200).json({ message: "کد جدید ارسال شد." });
  } catch (err) {
    next(err);
  }
}

export async function resendPhoneVerification(req: Request, res: Response, next: NextFunction) {
  try {
    await resendPhoneVerificationCode(req.body.phone);
    res.status(200).json({ message: "کد جدید پیامک شد." });
  } catch (err) {
    next(err);
  }
}
