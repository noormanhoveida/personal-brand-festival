import { Request, Response } from "express";
import { businessShowcaseService } from "./business-showcase.service";
import {
  createBusinessVideoSchema,
  addCommentSchema,
  adminReviewSchema,
} from "./business-showcase.validator";
import { BusinessCategory, BusinessVideoStatus, Role } from "@prisma/client";

export class BusinessShowcaseController {
  /**
   * آپلود تک‌فایل ویدیو (حداکثر ۵۰ مگابایت)
   */
  async uploadVideoFile(req: Request, res: Response) {
    try {
      if (!req.file) {
        return res.status(400).json({ message: "هیچ فایلی ارسال نشده است." });
      }
      const videoUrl = `/uploads/${req.file.filename}`;
      return res.status(201).json({
        message: "ویدیو با موفقیت بارگذاری شد.",
        videoUrl,
        fileSizeBytes: req.file.size,
      });
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در آپلود ویدیو" });
    }
  }

  /**
   * لیست ویدیوهای عمومی ویترین
   */
  async getPublicList(req: Request, res: Response) {
    try {
      const category = req.query.category as BusinessCategory | undefined;
      const page = Number(req.query.page) || 1;
      const limit = Number(req.query.limit) || 12;

      const data = await businessShowcaseService.getPublicList(category, page, limit);
      return res.json(data);
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در دریافت لیست ویدیوها" });
    }
  }

  /**
   * دریافت جزییات یک ویدیو
   */
  async getById(req: Request, res: Response) {
    try {
      const { id } = req.params;
      const currentUserId = req.user?.userId;
      const isAdmin = req.user?.role === Role.ADMIN;

      const video = await businessShowcaseService.getById(id, currentUserId, isAdmin);
      if (!video) {
        return res.status(404).json({ message: "ویدیو یافت نشد یا هنوز تایید نشده است." });
      }
      return res.json(video);
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در دریافت ویدیو" });
    }
  }

  /**
   * ویدیوهای من (کاربر لاگین شده)
   */
  async getMyVideos(req: Request, res: Response) {
    try {
      const userId = req.user?.userId;
      if (!userId) return res.status(401).json({ message: "احراز هویت الزامی است." });

      const videos = await businessShowcaseService.getMyVideos(userId);
      return res.json(videos);
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در دریافت ویدیوهای شما" });
    }
  }

  /**
   * ایجاد رکورد ویدیوی جدید پس از اعتبارسنجی
   */
  async create(req: Request, res: Response) {
    try {
      const userId = req.user?.userId;
      if (!userId) return res.status(401).json({ message: "احراز هویت الزامی است." });

      const parsed = createBusinessVideoSchema.safeParse(req.body);
      if (!parsed.success) {
        const errorMsg = parsed.error.issues[0]?.message || "اطلاعات ارسالی نامعتبر است.";
        return res.status(400).json({ message: errorMsg, errors: parsed.error.issues });
      }

      const video = await businessShowcaseService.createVideo(userId, parsed.data);
      return res.status(201).json({
        message: "ویدیوی شما با موفقیت ثبت شد و پس از بررسی ادمین در ویترین نمایش داده می‌شود.",
        video,
      });
    } catch (e: any) {
      return res.status(400).json({ message: e.message || "خطا در ثبت ویدیو" });
    }
  }

  /**
   * حذف ویدیو
   */
  async delete(req: Request, res: Response) {
    try {
      const userId = req.user?.userId;
      if (!userId) return res.status(401).json({ message: "احراز هویت الزامی است." });
      const isAdmin = req.user?.role === Role.ADMIN;

      await businessShowcaseService.deleteVideo(req.params.id, userId, isAdmin);
      return res.json({ message: "ویدیو با موفقیت حذف شد." });
    } catch (e: any) {
      return res.status(400).json({ message: e.message || "خطا در حذف ویدیو" });
    }
  }

  /**
   * پسندیدن / برداشتن پسند
   */
  async toggleLike(req: Request, res: Response) {
    try {
      const userId = req.user?.userId;
      if (!userId) return res.status(401).json({ message: "برای پسندیدن ویدیو ابتدا وارد شوید." });

      const result = await businessShowcaseService.toggleLike(req.params.id, userId);
      return res.json(result);
    } catch (e: any) {
      return res.status(400).json({ message: e.message || "خطا در پردازش لایک" });
    }
  }

  /**
   * مشاهده کامنت‌ها
   */
  async getComments(req: Request, res: Response) {
    try {
      const comments = await businessShowcaseService.getComments(req.params.id);
      return res.json(comments);
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در دریافت نظرات" });
    }
  }

  /**
   * افزودن کامنت
   */
  async addComment(req: Request, res: Response) {
    try {
      const userId = req.user?.userId;
      if (!userId) return res.status(401).json({ message: "برای ارسال نظر ابتدا وارد شوید." });

      const parsed = addCommentSchema.safeParse(req.body);
      if (!parsed.success) {
        return res.status(400).json({ message: parsed.error.issues[0]?.message || "متن نامعتبر است." });
      }

      const comment = await businessShowcaseService.addComment(
        req.params.id,
        userId,
        parsed.data.content,
        parsed.data.parentId
      );
      return res.status(201).json(comment);
    } catch (e: any) {
      return res.status(400).json({ message: e.message || "خطا در ثبت نظر" });
    }
  }

  /**
   * تغییر وضعیت توسط ادمین
   */
  async adminReview(req: Request, res: Response) {
    try {
      const parsed = adminReviewSchema.safeParse(req.body);
      if (!parsed.success) {
        return res.status(400).json({ message: parsed.error.issues[0]?.message || "داده‌ها نامعتبرند." });
      }

      const updated = await businessShowcaseService.adminUpdateStatus(
        req.params.id,
        parsed.data.status,
        parsed.data.rejectionReason,
        parsed.data.isFeatured,
        parsed.data.order
      );
      return res.json({ message: "وضعیت ویدیو با موفقیت تغییر کرد.", video: updated });
    } catch (e: any) {
      return res.status(400).json({ message: e.message || "خطا در بروزرسانی وضعیت ویدیو" });
    }
  }

  /**
   * لیست ویدیوها در پنل مدیریت
   */
  async adminList(req: Request, res: Response) {
    try {
      const status = req.query.status as BusinessVideoStatus | undefined;
      const page = Number(req.query.page) || 1;
      const limit = Number(req.query.limit) || 20;

      const data = await businessShowcaseService.adminList(status, page, limit);
      return res.json(data);
    } catch (e: any) {
      return res.status(500).json({ message: e.message || "خطا در دریافت لیست مدیریت" });
    }
  }
}

export const businessShowcaseController = new BusinessShowcaseController();
