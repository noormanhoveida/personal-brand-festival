import { z } from "zod";

export const SponsorPlacementEnum = z.enum(["DASHBOARD", "LANDING_HERO", "LANDING_VERTICAL"]);
export const SponsorSlideTypeEnum = z.enum(["IMAGE", "YOUTUBE"]);

export const createSponsorSchema = z.object({
  name: z.string().min(2, "نام اسپانسر حداقل ۲ کاراکتر است"),
  slug: z.string().min(2, "اسلاگ حداقل ۲ کاراکتر است").regex(/^[a-z0-9-]+$/, "اسلاگ فقط حروف کوچک انگلیسی، عدد و خط تیره مجاز است"),
  tagline: z.string().optional().nullable(),
  placement: SponsorPlacementEnum.default("DASHBOARD"),
  slideType: SponsorSlideTypeEnum.default("IMAGE"),
  slideMediaUrl: z.string().url("آدرس مدیا نامعتبر است"),
  logoUrl: z.string().url("آدرس لوگو نامعتبر است").optional().nullable(),
  coverUrl: z.string().url("آدرس کاور نامعتبر است").optional().nullable(),
  description: z.string().optional().nullable(),
  actionText: z.string().optional().nullable(),
  actionUrl: z.string().url("آدرس دکمه اکشن نامعتبر است").optional().nullable(),
  websiteUrl: z.string().url().optional().nullable(),
  instagramUrl: z.string().optional().nullable(),
  linkedinUrl: z.string().optional().nullable(),
  telegramUrl: z.string().optional().nullable(),
  order: z.number().int().default(0),
  isActive: z.boolean().default(true),
});

export const updateSponsorSchema = createSponsorSchema.partial();
